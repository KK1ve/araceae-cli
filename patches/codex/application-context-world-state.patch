+use super::*;
+use crate::context::world_state::WorldState;
+use codex_protocol::models::ResponseItem;
+use pretty_assertions::assert_eq;
+
+fn supplied(
+    entries: &[(&str, &str, AdditionalContextKind)],
+) -> BTreeMap<String, AdditionalContextEntry> {
+    entries
+        .iter()
+        .map(|(key, value, kind)| {
+            (
+                (*key).to_string(),
+                AdditionalContextEntry {
+                    value: (*value).to_string(),
+                    kind: *kind,
+                },
+            )
+        })
+        .collect()
+}
+
+fn rendered(entries: &[(&str, &str)], notice: Option<&'static str>) -> ResponseItem {
+    ContextualUserFragment::into(ApplicationContext {
+        entries: entries
+            .iter()
+            .map(|(key, value)| ((*key).to_string(), (*value).to_string()))
+            .collect(),
+        notice,
+    })
+}
+
+fn render(
+    entries: &[(&str, &str, AdditionalContextKind)],
+    previous: Option<&super::super::WorldStateSnapshot>,
+    history: &[ResponseItem],
+) -> (super::super::WorldStateSnapshot, Vec<ResponseItem>) {
+    let mut world_state = WorldState::default();
+    world_state.add_section(ApplicationContextState::new(&supplied(entries)));
+    let (snapshot, fragments) = world_state.render_history_fragment_diff(previous, history);
+    (
+        snapshot,
+        fragments
+            .into_iter()
+            .map(ContextualUserFragment::into_boxed_response_item)
+            .collect(),
+    )
+}
+
+#[test]
+fn application_context_is_replaced_whole_and_resent_when_history_loses_it() {
+    use AdditionalContextKind::Application;
+    use AdditionalContextKind::Untrusted;
+
+    let mut history: Vec<ResponseItem> = Vec::new();
+    let mut previous = None;
+    for (entries, expected) in [
+        (vec![], None),
+        (
+            vec![
+                ("policy", "one", Application),
+                ("browser", "tab", Untrusted),
+            ],
+            Some(rendered(&[("policy", "one")], None)),
+        ),
+        (vec![("policy", "one", Application)], None),
+        (vec![], None),
+        (
+            vec![
+                ("policy", "two", Application),
+                ("runtime", "idle", Application),
+            ],
+            Some(rendered(
+                &[("policy", "two"), ("runtime", "idle")],
+                Some(REPLACEMENT_NOTICE),
+            )),
+        ),
+    ] {
+        let (snapshot, updates) = render(&entries, previous.as_ref(), &history);
+        assert_eq!(updates, expected.into_iter().collect::<Vec<_>>());
+        history.extend(updates);
+        previous = Some(snapshot);
+    }
+
+    let current = [
+        ("policy", "two", Application),
+        ("runtime", "idle", Application),
+    ];
+    assert_eq!(render(&current, previous.as_ref(), &history).1, Vec::new());
+    assert_eq!(
+        render(&current, previous.as_ref(), &[]).1,
+        vec![rendered(&[("policy", "two"), ("runtime", "idle")], None)]
+    );
+}
+
+#[test]
+fn application_context_limit_includes_replacement_notice_and_markers() {
+    let overhead = ApplicationContext {
+        entries: BTreeMap::from([("policy".to_string(), String::new())]),
+        notice: Some(REPLACEMENT_NOTICE),
+    }
+    .render()
+    .len();
+    let fitting = "x".repeat(approx_bytes_for_tokens(MAX_APPLICATION_CONTEXT_TOKENS) - overhead);
+    let mut entries = supplied(&[
+        ("policy", &fitting, AdditionalContextKind::Application),
+        ("page", &fitting, AdditionalContextKind::Untrusted),
+    ]);
+    assert_eq!(validate_application_context(&entries), Ok(()));
+
+    if let Some(policy) = entries.get_mut("policy") {
+        policy.value.push('x');
+    }
+    let error = validate_application_context(&entries)
+        .expect_err("oversized application context must not be silently truncated");
+    assert!(error.contains("10000 estimated tokens"), "{error}");
+}
