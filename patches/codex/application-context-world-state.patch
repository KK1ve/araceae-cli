+//! Application-supplied additional context kept in model history as one replaceable message.
+
+use super::PreviousSectionState;
+use super::SectionTransition;
+use super::WorldStateHash;
+use super::WorldStateSection;
+use super::WorldStateUpdate;
+use crate::context::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+use codex_protocol::protocol::AdditionalContextEntry;
+use codex_protocol::protocol::AdditionalContextKind;
+use codex_utils_string::approx_bytes_for_tokens;
+use codex_utils_string::approx_tokens_from_byte_count;
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+
+const MAX_APPLICATION_CONTEXT_TOKENS: usize = 10_000;
+const START_MARKER: &str = "<application_context>";
+const END_MARKER: &str = "</application_context>";
+const REPLACEMENT_NOTICE: &str =
+    "This application context replaces all previously provided application context.";
+
+#[derive(Clone, Debug)]
+struct ApplicationContext {
+    entries: BTreeMap<String, String>,
+    notice: Option<&'static str>,
+}
+
+impl ContextualUserFragment for ApplicationContext {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("application_context".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        (START_MARKER, END_MARKER)
+    }
+
+    fn body(&self) -> String {
+        render_body(
+            self.entries
+                .iter()
+                .map(|(key, value)| (key.as_str(), value.as_str())),
+            self.notice,
+        )
+    }
+}
+
+fn render_body<'a>(
+    entries: impl Iterator<Item = (&'a str, &'a str)>,
+    notice: Option<&str>,
+) -> String {
+    let mut body = String::from("\n");
+    if let Some(notice) = notice {
+        body.push_str(notice);
+        body.push_str("\n\n");
+    }
+    for (key, value) in entries {
+        body.push_str(&format!("<{key}>\n{value}\n</{key}>\n"));
+    }
+    body
+}
+
+fn application_entries(
+    entries: &BTreeMap<String, AdditionalContextEntry>,
+) -> impl Iterator<Item = (&str, &str)> {
+    entries
+        .iter()
+        .filter(|(_, entry)| entry.kind == AdditionalContextKind::Application)
+        .map(|(key, entry)| (key.as_str(), entry.value.as_str()))
+}
+
+/// Rejects application context that would not fit its model-context budget once rendered.
+///
+/// The section is never truncated, so oversized context must be refused before a turn starts.
+pub fn validate_application_context(
+    entries: &BTreeMap<String, AdditionalContextEntry>,
+) -> Result<(), String> {
+    if application_entries(entries).next().is_none() {
+        return Ok(());
+    }
+    // Reserve the notice used when an existing conversation receives new context.
+    let rendered_bytes = START_MARKER.len()
+        + render_body(application_entries(entries), Some(REPLACEMENT_NOTICE)).len()
+        + END_MARKER.len();
+    if rendered_bytes > approx_bytes_for_tokens(MAX_APPLICATION_CONTEXT_TOKENS) {
+        let estimated_tokens = approx_tokens_from_byte_count(rendered_bytes);
+        return Err(format!(
+            "application additionalContext exceeds the model-context limit of {MAX_APPLICATION_CONTEXT_TOKENS} estimated tokens ({estimated_tokens} including context markers)"
+        ));
+    }
+    Ok(())
+}
+
+/// The application context most recently supplied to the session.
+#[derive(Clone, Debug)]
+pub(crate) struct ApplicationContextState {
+    context: Option<ApplicationContext>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct ApplicationContextSnapshot {
+    context: WorldStateHash,
+}
+
+impl ApplicationContextState {
+    pub(crate) fn new(entries: &BTreeMap<String, AdditionalContextEntry>) -> Self {
+        let entries = application_entries(entries)
+            .map(|(key, value)| (key.to_string(), value.to_string()))
+            .collect::<BTreeMap<_, _>>();
+        Self {
+            context: (!entries.is_empty()).then_some(ApplicationContext {
+                entries,
+                notice: None,
+            }),
+        }
+    }
+}
+
+impl WorldStateSection for ApplicationContextState {
+    const ID: &'static str = "application_context";
+    type Snapshot = ApplicationContextSnapshot;
+
+    fn has_retained_fragment_matcher() -> bool {
+        true
+    }
+
+    fn matches_retained_fragment(role: &str, text: &str) -> bool {
+        role == "developer" && ApplicationContext::matches_text(text)
+    }
+
+    fn render_diff(
+        &self,
+        previous: PreviousSectionState<'_, Self::Snapshot>,
+    ) -> SectionTransition<Self::Snapshot> {
+        // Turns that omit application context leave the model-visible context unchanged.
+        let Some(context) = &self.context else {
+            return (None, Vec::new());
+        };
+        let current = ApplicationContextSnapshot {
+            context: WorldStateHash::from_fragment(context),
+        };
+        let notice = match previous {
+            PreviousSectionState::Known(previous) if previous == &current => {
+                return (Some(current), Vec::new());
+            }
+            PreviousSectionState::Absent => None,
+            PreviousSectionState::Known(_) | PreviousSectionState::Unknown => {
+                Some(REPLACEMENT_NOTICE)
+            }
+        };
+        let fragment = ApplicationContext {
+            entries: context.entries.clone(),
+            notice,
+        };
+        (
+            Some(current),
+            vec![WorldStateUpdate::fragment(fragment).standalone()],
+        )
+    }
+}
+
+#[cfg(test)]
+#[path = "application_context_tests.rs"]
+mod tests;
