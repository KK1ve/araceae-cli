+
+/// Remembers the bearer credential a request actually carried after auth was applied.
+fn record_applied_bearer(slot: &Mutex<Option<String>>, headers: &HeaderMap) {
+    let bearer = headers
+        .get(http::header::AUTHORIZATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .map(str::to_string);
+    if let Ok(mut slot) = slot.lock() {
+        *slot = bearer;
+    }
 }
 
