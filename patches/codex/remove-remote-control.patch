+}
+
+// The snapshots include optional product APIs. Derive the exported method surface
+// from the same macro invocations as the runtime dispatcher, without binary patches.
+fn filter_schema_methods(value: &mut serde_json::Value, methods: &BTreeMap<&str, Vec<String>>) {
+    if let Some(registered) = value
+        .get("title")
+        .and_then(|v| v.as_str())
+        .and_then(|name| methods.get(name))
+        && let Some(variants) = value.get_mut("oneOf").and_then(|v| v.as_array_mut())
+    {
+        variants.retain(|variant| {
+            variant
+                .pointer("/properties/method/enum/0")
+                .and_then(|v| v.as_str())
+                .is_none_or(|method| registered.iter().any(|name| name == method))
+        });
+    }
+    match value {
+        serde_json::Value::Object(object) => {
+            for child in object.values_mut() {
+                filter_schema_methods(child, methods);
+            }
+        }
+        serde_json::Value::Array(array) => {
+            for child in array {
+                filter_schema_methods(child, methods);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn filter_typescript_methods(contents: &str, name: &str, registered: &[String]) -> Result<String> {
+    let prefix = format!("export type {name} =");
+    let (header, declaration) = contents
+        .split_once(&prefix)
+        .context("missing precomputed TypeScript protocol declaration")?;
+    let body = declaration
+        .trim()
+        .strip_suffix(';')
+        .context("unterminated precomputed TypeScript protocol declaration")?;
+    let (envelope, body) = if let Some((envelope, union)) = body.split_once(" & (") {
+        (
+            Some(envelope),
+            union
+                .strip_suffix(')')
+                .context("unterminated notification envelope")?,
+        )
+    } else {
+        (None, body)
+    };
+    let delimiter = " | { \"method\": ";
+    let mut retained = Vec::new();
+    for (index, member) in body.split(delimiter).enumerate() {
+        let member = if index == 0 {
+            member.to_owned()
+        } else {
+            format!("{{ \"method\": {member}")
+        };
+        let method = member
+            .strip_prefix(r#"{ "method": ""#)
+            .and_then(|rest| rest.split_once('\"').map(|(method, _)| method))
+            .context("unexpected precomputed TypeScript protocol union format")?;
+        if registered.iter().any(|name| name == method) {
+            retained.push(member);
+        }
+    }
+    if retained.is_empty() {
+        bail!("empty precomputed TypeScript protocol union {name}");
+    }
+    let body = retained.join(" | ");
+    let body = envelope.map_or_else(|| body.clone(), |envelope| format!("{envelope} & ({body})"));
+    let used: std::collections::HashSet<&str> = body
+        .split(|c: char| !c.is_alphanumeric() && c != '_')
+        .collect();
+    let header: String = header
+        .lines()
+        .filter(|line| {
+            line.strip_prefix("import type { ")
+                .and_then(|rest| rest.split_once(" }").map(|(name, _)| name))
+                .is_none_or(|name| used.contains(name))
+        })
+        .map(|line| format!("{line}\n"))
+        .collect();
+    Ok(format!("{header}{prefix} {body};\n"))
 }
 
