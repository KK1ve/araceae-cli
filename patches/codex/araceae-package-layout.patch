--- a/scripts/codex_package/layout.py
+++ b/scripts/codex_package/layout.py
@@ -6,6 +6,9 @@ import stat
 from pathlib import Path
 
 from .targets import COMMAND_RUNNER_BIN
+from .targets import PACKAGE_METADATA_FILENAME
+from .targets import PATH_DIRNAME
+from .targets import RESOURCES_DIRNAME
 from .targets import WINDOWS_SANDBOX_SETUP_BIN
 from .targets import PackageInputs
 from .targets import PackageVariant
