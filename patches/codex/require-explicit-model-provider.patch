From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Araceae Runtime <runtime@araceae.invalid>
Date: Sat, 17 Oct 2026 12:58:51 +0800
Subject: [PATCH] Require an explicit provider without native account fallback

---
 codex-rs/core/src/config/mod.rs  | 18 +++++++++++++++++-
 codex-rs/runtime-cli/src/main.rs |  2 +-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/codex-rs/core/src/config/mod.rs b/codex-rs/core/src/config/mod.rs
index c5ab36546e189781c8b1f957cf56d8d31ad3d7fe..96ad8bab38d3de094ab7e0cd087c89b422890109 100644
--- a/codex-rs/core/src/config/mod.rs
+++ b/codex-rs/core/src/config/mod.rs
@@ -3936,7 +3936,10 @@ impl Config {
         let model_provider_id = config_layer_stack.required_model_provider().map(str::to_string)
             .or(model_provider)
             .or(cfg.model_provider)
-            .unwrap_or_else(|| "openai".to_string());
+            .ok_or_else(|| std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "Explicit model_provider configuration is required; native account fallback is unavailable",
+            ))?;
         let model_provider = model_providers
             .get(&model_provider_id)
             .ok_or_else(|| {
@@ -3949,6 +3952,19 @@ impl Config {
             })?
             .clone();
 
+        if model_provider.requires_openai_auth || model_provider.uses_openai_actor_authorization() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "The selected provider requires native account authentication; configure env_key or auth.command instead",
+            ));
+        }
+        if model_provider.base_url.as_ref().is_none_or(|url| url.trim().is_empty()) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "The selected provider requires an explicit base_url",
+            ));
+        }
+
         let shell_environment_policy = ShellEnvironmentPolicy::from(cfg.shell_environment_policy);
         let allow_login_shell = cfg.allow_login_shell.unwrap_or(true);
 
diff --git a/codex-rs/runtime-cli/src/main.rs b/codex-rs/runtime-cli/src/main.rs
index f69258b78413b22d110bd503aadc2f81a861cc5d..ac3731875012615230cb2f38272911414d378166 100644
--- a/codex-rs/runtime-cli/src/main.rs
+++ b/codex-rs/runtime-cli/src/main.rs
@@ -145,7 +145,7 @@ fn main() -> anyhow::Result<()> {
                     arg0_paths,
                     config_overrides,
                     LoaderOverrides::default(),
-                    strict_config,
+                    true,
                     server.analytics_default_enabled,
                     transport,
                     SessionSource::VSCode,
