@@ -0,0 +1,164 @@
+//! Recognizes gateways that answer a model request with an HTTP 2xx JSON error envelope.
+
+use crate::error::ApiError;
+use bytes::Bytes;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use futures::StreamExt;
+use http::HeaderMap;
+use http::StatusCode;
+use regex_lite::Regex;
+use serde_json::Value;
+
+/// Largest 2xx JSON body read while looking for an error envelope.
+const MAX_INSPECTED_BODY_BYTES: usize = 1024 * 1024;
+
+/// Detection rules for an HTTP 2xx `{"code": <non-zero>, "reason": "...", "message": "..."}`
+/// body that a gateway returns in place of a model response.
+#[derive(Debug, Clone)]
+pub struct ErrorEnvelopePolicy {
+    auth_failure_reasons: Vec<String>,
+    auth_failure_message: Option<Regex>,
+}
+
+impl ErrorEnvelopePolicy {
+    /// `auth_failure_reasons` are compared with the segment of the envelope reason after its
+    /// last `.`; `auth_failure_message_pattern` is matched against the envelope message.
+    pub fn new(
+        auth_failure_reasons: Vec<String>,
+        auth_failure_message_pattern: Option<&str>,
+    ) -> Result<Self, regex_lite::Error> {
+        Ok(Self {
+            auth_failure_reasons,
+            auth_failure_message: auth_failure_message_pattern.map(Regex::new).transpose()?,
+        })
+    }
+
+    fn refuses_credential(&self, envelope: &ErrorEnvelope) -> bool {
+        let reason = envelope.reason.rsplit('.').next().unwrap_or_default();
+        self.auth_failure_reasons
+            .iter()
+            .any(|candidate| candidate == reason)
+            || self
+                .auth_failure_message
+                .as_ref()
+                .is_some_and(|pattern| pattern.is_match(&envelope.message))
+    }
+}
+
+struct ErrorEnvelope {
+    code: String,
+    reason: String,
+    message: String,
+}
+
+fn parse_envelope(body: &[u8]) -> Option<ErrorEnvelope> {
+    let value: Value = serde_json::from_slice(body).ok()?;
+    let object = value.as_object()?;
+    let code = object.get("code")?;
+    if !code.is_number() || code.as_f64() == Some(0.0) {
+        return None;
+    }
+    Some(ErrorEnvelope {
+        code: code.to_string(),
+        reason: object.get("reason")?.as_str()?.to_string(),
+        message: object.get("message")?.as_str()?.to_string(),
+    })
+}
+
+fn is_json(headers: &HeaderMap) -> bool {
+    headers
+        .get(http::header::CONTENT_TYPE)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.split(';').next())
+        .is_some_and(|value| value.trim().eq_ignore_ascii_case("application/json"))
+}
+
+/// A 2xx reply after error-envelope inspection.
+pub(crate) enum SuccessBody {
+    /// A reply that is not JSON, untouched.
+    Stream(StreamResponse),
+    /// A complete JSON body that is not an error envelope.
+    Json {
+        status: StatusCode,
+        headers: HeaderMap,
+        body: Bytes,
+    },
+}
+
+impl SuccessBody {
+    /// Returns the reply as a byte stream for parsers that read events.
+    pub(crate) fn into_stream(self) -> StreamResponse {
+        match self {
+            SuccessBody::Stream(response) => response,
+            SuccessBody::Json {
+                status,
+                headers,
+                body,
+            } => StreamResponse {
+                status,
+                headers,
+                bytes: futures::stream::once(async move { Ok(body) }).boxed(),
+            },
+        }
+    }
+}
+
+/// Converts an error envelope into the error its meaning maps to.
+///
+/// A refused credential becomes an HTTP 401 transport error so unauthorized recovery refreshes
+/// it; any other envelope becomes a non-retryable invalid request carrying the gateway's text.
+pub(crate) async fn inspect_success_response(
+    response: StreamResponse,
+    policy: Option<&ErrorEnvelopePolicy>,
+) -> Result<SuccessBody, ApiError> {
+    let Some(policy) = policy else {
+        return Ok(SuccessBody::Stream(response));
+    };
+    if !is_json(&response.headers) {
+        return Ok(SuccessBody::Stream(response));
+    }
+    let StreamResponse {
+        status,
+        headers,
+        mut bytes,
+    } = response;
+    let mut body = Vec::new();
+    while let Some(chunk) = bytes.next().await {
+        let chunk = chunk.map_err(ApiError::Transport)?;
+        if body.len() + chunk.len() > MAX_INSPECTED_BODY_BYTES {
+            return Err(ApiError::Stream(format!(
+                "model gateway returned a JSON body larger than {MAX_INSPECTED_BODY_BYTES} bytes"
+            )));
+        }
+        body.extend_from_slice(&chunk);
+    }
+    let Some(envelope) = parse_envelope(&body) else {
+        return Ok(SuccessBody::Json {
+            status,
+            headers,
+            body: Bytes::from(body),
+        });
+    };
+    if policy.refuses_credential(&envelope) {
+        return Err(ApiError::Transport(TransportError::Http {
+            status: StatusCode::UNAUTHORIZED,
+            url: None,
+            headers: Some(headers),
+            body: Some(String::from_utf8_lossy(&body).into_owned()),
+            retry_after: None,
+        }));
+    }
+    let label = if envelope.reason.is_empty() {
+        envelope.code
+    } else {
+        envelope.reason
+    };
+    Err(ApiError::InvalidRequest {
+        message: format!("model gateway returned {label}: {}", envelope.message),
+    })
+}
+
+#[cfg(test)]
+#[path = "error_envelope_tests.rs"]
+mod tests;
