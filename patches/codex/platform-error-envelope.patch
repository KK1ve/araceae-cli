diff --git a/codex-rs/model-provider-info/src/error_envelope.rs b/codex-rs/model-provider-info/src/error_envelope.rs
new file mode 100644
index 0000000000000000000000000000000000000000..886e96c1d685afa5bdc6f6e9fc676fd10eca435b
--- /dev/null
+++ b/codex-rs/model-provider-info/src/error_envelope.rs
@@ -0,0 +1,52 @@
+//! Settings for gateways that report failures as an HTTP 2xx JSON error envelope.
+
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Recognizes an HTTP 2xx `{"code": <non-zero>, "reason": "...", "message": "..."}` body that a
+/// gateway returns in place of a model response, and the replies that refuse a credential.
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct ModelProviderErrorEnvelope {
+    /// Envelope reasons that mean the presented credential was refused, compared with the
+    /// segment of the reason after its last `.`.
+    #[serde(default)]
+    pub auth_failure_reasons: Vec<String>,
+    /// Regular expression matched against the envelope message to recognize a refused
+    /// credential.
+    pub auth_failure_message_pattern: Option<String>,
+    /// HTTP statuses that also mean the presented credential was refused. 401 always does.
+    #[serde(default)]
+    pub auth_failure_statuses: Vec<u16>,
+}
+
+impl ModelProviderErrorEnvelope {
+    pub(crate) fn validate(&self) -> Result<(), String> {
+        if self
+            .auth_failure_reasons
+            .iter()
+            .any(|reason| reason.trim().is_empty())
+        {
+            return Err(
+                "provider error_envelope.auth_failure_reasons must not contain empty values"
+                    .to_string(),
+            );
+        }
+        if let Some(pattern) = &self.auth_failure_message_pattern {
+            regex_lite::Regex::new(pattern).map_err(|error| {
+                format!("provider error_envelope.auth_failure_message_pattern is invalid: {error}")
+            })?;
+        }
+        if let Some(status) = self
+            .auth_failure_statuses
+            .iter()
+            .find(|status| !(400..=599).contains(*status))
+        {
+            return Err(format!(
+                "provider error_envelope.auth_failure_statuses contains {status}, which is not an HTTP error status"
+            ));
+        }
+        Ok(())
+    }
+}
