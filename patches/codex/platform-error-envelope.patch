+use super::*;
+use pretty_assertions::assert_eq;
+
+fn json_response(body: &'static str) -> StreamResponse {
+    let mut headers = HeaderMap::new();
+    headers.insert(
+        http::header::CONTENT_TYPE,
+        http::HeaderValue::from_static("application/json; charset=utf-8"),
+    );
+    StreamResponse {
+        status: StatusCode::OK,
+        headers,
+        bytes: futures::stream::once(async move { Ok(Bytes::from_static(body.as_bytes())) })
+            .boxed(),
+    }
+}
+
+fn policy() -> ErrorEnvelopePolicy {
+    ErrorEnvelopePolicy::new(
+        vec!["ERROR_LOGIN_EXPIRED".to_string()],
+        Some("登录已(?:失效|过期)"),
+    )
+    .expect("valid policy")
+}
+
+#[tokio::test]
+async fn refused_credentials_become_unauthorized_transport_errors() {
+    for body in [
+        r#"{"code":16,"reason":"user.v1.ERROR_LOGIN_EXPIRED","message":"expired"}"#,
+        r#"{"code":500,"reason":"","message":"登录已失效，请重新登录"}"#,
+    ] {
+        let error = inspect_success_response(json_response(body), Some(&policy()))
+            .await
+            .err()
+            .expect("envelope must fail");
+        let ApiError::Transport(TransportError::Http {
+            status,
+            body: forwarded,
+            ..
+        }) = error
+        else {
+            panic!("expected an HTTP transport error, got {error:?}");
+        };
+        assert_eq!(status, StatusCode::UNAUTHORIZED);
+        assert_eq!(forwarded.as_deref(), Some(body));
+    }
+}
+
+#[tokio::test]
+async fn other_envelopes_become_invalid_requests() {
+    let error = inspect_success_response(
+        json_response(r#"{"code":7,"reason":"MODEL_DISABLED","message":"模型已停用"}"#),
+        Some(&policy()),
+    )
+    .await
+    .err()
+    .expect("envelope must fail");
+    let ApiError::InvalidRequest { message } = error else {
+        panic!("expected an invalid request, got {error:?}");
+    };
+    assert_eq!(message, "model gateway returned MODEL_DISABLED: 模型已停用");
+}
+
+#[tokio::test]
+async fn ordinary_json_and_streams_pass_through() {
+    let body = r#"{"id":"chatcmpl-1","choices":[]}"#;
+    let SuccessBody::Json { body: bytes, .. } =
+        inspect_success_response(json_response(body), Some(&policy()))
+            .await
+            .expect("plain JSON passes")
+    else {
+        panic!("expected a JSON body");
+    };
+    assert_eq!(bytes, Bytes::from_static(body.as_bytes()));
+
+    let zero_code = r#"{"code":0,"reason":"","message":"ok"}"#;
+    assert!(matches!(
+        inspect_success_response(json_response(zero_code), Some(&policy())).await,
+        Ok(SuccessBody::Json { .. })
+    ));
+    assert!(matches!(
+        inspect_success_response(json_response(zero_code), None).await,
+        Ok(SuccessBody::Stream(_))
+    ));
+}
