 /// Returns a custom tool that can be used to edit files. Well-suited for GPT-5 models
 /// https://platform.openai.com/docs/guides/function-calling#custom-tools
 pub fn create_apply_patch_freeform_tool(include_environment_id: bool) -> ToolSpec {
@@ -27,6 +109,33 @@ pub fn create_apply_patch_freeform_tool(include_environment_id: bool) -> ToolSpe
     })
 }
 
+/// Returns a JSON function tool that edits files, for models without custom tool calls.
+pub fn create_apply_patch_json_tool(include_environment_id: bool) -> ToolSpec {
+    let properties = BTreeMap::from([(
+        "input".to_string(),
+        JsonSchema::string(Some(
+            "The entire contents of the apply_patch command".to_string(),
+        )),
+    )]);
+    let mut description = APPLY_PATCH_JSON_TOOL_DESCRIPTION.to_string();
+    if include_environment_id {
+        description.push_str(APPLY_PATCH_JSON_ENVIRONMENT_ID_GUIDANCE);
+    }
+
+    ToolSpec::Function(ResponsesApiTool {
+        name: "apply_patch".to_string(),
+        description,
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            properties,
+            Some(vec!["input".to_string()]),
+            Some(false.into()),
+        ),
+        output_schema: None,
+    })
+}
+
