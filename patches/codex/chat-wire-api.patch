+            structured_output: ChatStructuredOutput::JsonObject,
+            include_usage: false,
+            ..Default::default()
+        },
+    )
+    .expect("chat request")
+    .body;
+    assert_eq!(
+        json_object["response_format"],
+        json!({ "type": "json_object" })
+    );
+    assert_eq!(json_object.get("stream_options"), None);
+    assert!(
+        json_object["messages"][0]["content"]
+            .as_str()
+            .is_some_and(|content| content.contains("{\"type\":\"object\"}"))
+    );
+}
+
+#[test]
+fn responses_only_items_are_dropped() {
+    let input = vec![
+        message("user", "go"),
+        ResponseItem::WebSearchCall {
+            encrypted_content: None,
+            id: None,
+            status: Some("completed".to_string()),
+            action: None,
+            internal_chat_message_metadata_passthrough: None,
+        },
+        ResponseItem::CompactionTrigger {},
+        message("assistant", "done"),
+    ];
+    assert_eq!(
+        messages(input, &ChatOptions::default()),
+        json!([
+            { "role": "user", "content": "go" },
+            { "role": "assistant", "content": "done" },
+        ])
+    );
+}
