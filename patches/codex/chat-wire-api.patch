+use super::*;
+use futures::stream;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn settings(think_tags: bool) -> ChatStreamSettings {
+    let mut tools = ToolAliasTable::default();
+    tools.insert(
+        Some("multi_agent_v1"),
+        "spawn_agent",
+        /*freeform*/ false,
+    );
+    tools.insert(None, "exec_command", /*freeform*/ false);
+    tools.insert(None, "apply_patch", /*freeform*/ true);
+    ChatStreamSettings {
+        tools: Arc::new(tools),
+        options: Arc::new(ChatOptions {
+            think_tags,
+            ..Default::default()
+        }),
+    }
+}
+
+fn chunk(delta: Value, finish_reason: Option<&str>) -> Value {
+    json!({
+        "id": "chatcmpl-1",
+        "object": "chat.completion.chunk",
+        "choices": [{ "index": 0, "delta": delta, "finish_reason": finish_reason }],
+    })
+}
+
+async fn run(
+    chunks: &[Value],
+    done: bool,
+    keep_open: bool,
+    settings: ChatStreamSettings,
+) -> Vec<String> {
+    let mut frames = chunks
+        .iter()
+        .map(|chunk| format!("data: {chunk}\n\n"))
+        .collect::<Vec<_>>();
+    if done {
+        frames.push("data: [DONE]\n\n".to_string());
+    }
+    let frames = stream::iter(
+        frames
+            .into_iter()
+            .map(|frame| Ok::<_, codex_client::TransportError>(Bytes::from(frame))),
+    );
+    let bytes: ByteStream = if keep_open {
+        frames.chain(stream::pending()).boxed()
+    } else {
+        frames.boxed()
+    };
+    let (tx_event, mut rx_event) = mpsc::channel(64);
+    process_chat_sse(bytes, tx_event, Duration::from_millis(200), None, settings).await;
+    let mut events = Vec::new();
+    while let Some(event) = rx_event.recv().await {
+        events.push(describe(event));
+    }
+    events
+}
+
+fn describe(event: Result<ResponseEvent, ApiError>) -> String {
+    match event {
+        Ok(ResponseEvent::Created { response_id }) => {
+            format!("created:{}", response_id.unwrap_or_default())
+        }
+        Ok(ResponseEvent::OutputItemAdded(item)) => format!("added:{}", describe_item(item)),
+        Ok(ResponseEvent::OutputItemDone(item)) => format!("done:{}", describe_item(item)),
+        Ok(ResponseEvent::ReasoningContentDelta { delta, .. }) => format!("reasoning:{delta}"),
+        Ok(ResponseEvent::OutputTextDelta(delta)) => format!("text:{delta}"),
+        Ok(ResponseEvent::Completed { token_usage, .. }) => match token_usage {
+            Some(usage) => format!(
+                "completed:{}/{}/{}/{}/{}",
+                usage.input_tokens,
+                usage.cached_input_tokens,
+                usage.output_tokens,
+                usage.reasoning_output_tokens,
+                usage.total_tokens
+            ),
+            None => "completed".to_string(),
+        },
+        Ok(other) => format!("other:{other:?}"),
+        Err(ApiError::ResponseIncomplete(incomplete)) => {
+            format!("error:incomplete:{}", incomplete.reason)
+        }
+        Err(ApiError::ContentFilter) => "error:content_filter".to_string(),
+        Err(ApiError::Retryable { .. }) => "error:retryable".to_string(),
+        Err(ApiError::ContextWindowExceeded) => "error:context_window".to_string(),
+        Err(ApiError::Stream(message)) => format!("error:stream:{message}"),
+        Err(other) => format!("error:{other}"),
+    }
+}
+
+fn describe_item(item: ResponseItem) -> String {
+    match item {
+        ResponseItem::Reasoning { content, .. } => format!(
+            "reasoning:{}",
+            content
+                .unwrap_or_default()
+                .into_iter()
+                .map(|content| match content {
+                    ReasoningItemContent::ReasoningText { text }
+                    | ReasoningItemContent::Text { text } => text,
+                })
+                .collect::<String>()
+        ),
+        ResponseItem::Message { content, .. } => format!(
+            "message:{}",
+            content
+                .into_iter()
+                .map(|content| match content {
+                    ContentItem::OutputText { text, .. } | ContentItem::InputText { text } => text,
+                    _ => String::new(),
+                })
+                .collect::<String>()
+        ),
+        ResponseItem::FunctionCall {
+            name,
+            namespace,
+            arguments,
+            call_id,
+            ..
+        } => format!(
+            "call:{}/{name}:{call_id}:{arguments}",
+            namespace.unwrap_or_default()
+        ),
+        ResponseItem::CustomToolCall {
+            name,
+            input,
+            call_id,
+            ..
+        } => format!("custom:{name}:{call_id}:{input}"),
+        other => format!("{other:?}"),
+    }
+}
+
