+//! Client for the Chat Completions endpoint of a provider whose `wire_api` is `chat`.
+
+use crate::auth::SharedAuthProvider;
+use crate::common::ResponseStream;
+use crate::common::ResponsesApiRequest;
+use crate::endpoint::chat_errors::ChatErrorClassifier;
+use crate::endpoint::error_envelope::ErrorEnvelopePolicy;
+use crate::endpoint::error_envelope::SuccessBody;
+use crate::endpoint::error_envelope::read_success_response;
+use crate::endpoint::responses::ResponsesOptions;
+use crate::endpoint::session::EndpointSession;
+use crate::error::ApiError;
+use crate::provider::Provider;
+use crate::requests::chat::ChatRequest;
+use crate::requests::chat::build_chat_request;
+use crate::requests::headers::build_session_headers;
+use crate::requests::headers::insert_header;
+use crate::requests::headers::subagent_header;
+use crate::sse::chat::ChatStreamSettings;
+use crate::sse::chat::request_id;
+use crate::sse::chat::spawn_chat_completion;
+use crate::sse::chat::spawn_chat_stream;
+use crate::telemetry::SseTelemetry;
+use codex_client::EncodedJsonBody;
+use codex_client::HttpTransport;
+use codex_client::RequestTelemetry;
+use codex_protocol::config_types::ChatOptions;
+use http::HeaderValue;
+use http::Method;
+use std::sync::Arc;
+use tracing::instrument;
+
+const CHAT_COMPLETIONS_PATH: &str = "/chat/completions";
+
+pub struct ChatClient<T: HttpTransport> {
+    session: EndpointSession<T>,
+    options: Arc<ChatOptions>,
+    sse_telemetry: Option<Arc<dyn SseTelemetry>>,
+    error_envelope: Option<Arc<ErrorEnvelopePolicy>>,
+}
+
+impl<T: HttpTransport> ChatClient<T> {
+    pub fn new(
+        transport: T,
+        provider: Provider,
+        auth: SharedAuthProvider,
+        options: Arc<ChatOptions>,
+    ) -> Self {
+        Self {
+            session: EndpointSession::new(transport, provider, auth),
+            options,
+            sse_telemetry: None,
+            error_envelope: None,
+        }
+    }
+
+    pub fn with_telemetry(
+        self,
+        request: Option<Arc<dyn RequestTelemetry>>,
+        sse: Option<Arc<dyn SseTelemetry>>,
+    ) -> Self {
+        Self {
+            session: self.session.with_request_telemetry(request),
+            sse_telemetry: sse,
+            ..self
+        }
+    }
+
+    /// Inspects 2xx JSON replies for a gateway error envelope before parsing them.
+    pub fn with_error_envelope(mut self, policy: Option<Arc<ErrorEnvelopePolicy>>) -> Self {
+        self.error_envelope = policy;
+        self
+    }
+
+    /// Bearer credential carried by the most recent request attempt.
+    pub fn applied_bearer(&self) -> Option<String> {
+        self.session.applied_bearer()
+    }
+
+    /// Sends a Responses request as a Chat Completions request and streams its events.
+    #[instrument(
+        name = "chat.stream_request",
+        level = "info",
+        skip_all,
+        fields(transport = "chat_http", http.method = "POST", api.path = CHAT_COMPLETIONS_PATH)
+    )]
+    pub async fn stream_request(
+        &self,
+        request: &ResponsesApiRequest,
+        options: ResponsesOptions,
+    ) -> Result<ResponseStream, ApiError> {
+        let ChatRequest { body, tools } = build_chat_request(request, &self.options)?;
+        let body = EncodedJsonBody::encode(&body)
+            .map_err(|err| ApiError::Stream(format!("failed to encode chat request: {err}")))?;
+        let ResponsesOptions {
+            session_id,
+            thread_id,
+            session_source,
+            extra_headers,
+            ..
+        } = options;
+        let mut headers = extra_headers;
+        if let Some(thread_id) = thread_id.as_ref() {
+            insert_header(&mut headers, "x-client-request-id", thread_id);
+        }
+        headers.extend(build_session_headers(session_id, thread_id));
+        if let Some(subagent) = subagent_header(&session_source) {
+            insert_header(&mut headers, "x-openai-subagent", &subagent);
+        }
+
+        let classifier = ChatErrorClassifier {
+            context_length_patterns: &self.options.context_length_error_patterns,
+        };
+        let response = self
+            .session
+            .stream_encoded_json_with(
+                Method::POST,
+                CHAT_COMPLETIONS_PATH,
+                headers,
+                Some(body),
+                |req| {
+                    req.headers.insert(
+                        http::header::ACCEPT,
+                        HeaderValue::from_static("text/event-stream"),
+                    );
+                },
+            )
+            .await
+            .map_err(|error| classifier.classify_request_error(error))?;
+        let settings = ChatStreamSettings {
+            tools,
+            options: Arc::clone(&self.options),
+        };
+        Ok(
+            match read_success_response(response, self.error_envelope.as_deref()).await? {
+                SuccessBody::Stream(response) => spawn_chat_stream(
+                    response,
+                    self.session.provider().stream_idle_timeout,
+                    self.sse_telemetry.clone(),
+                    settings,
+                ),
+                SuccessBody::Json { headers, body, .. } => {
+                    spawn_chat_completion(body, request_id(&headers), settings)
+                }
+            },
+        )
+    }
+}
