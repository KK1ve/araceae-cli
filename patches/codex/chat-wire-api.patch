+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn http(status: u16, body: &str) -> ApiError {
+    ApiError::Transport(TransportError::Http {
+        status: StatusCode::from_u16(status).expect("status"),
+        url: None,
+        headers: None,
+        body: Some(body.to_string()),
+        retry_after: None,
+    })
+}
+
+fn classify(status: u16, body: &str, patterns: &[String]) -> ApiError {
+    ChatErrorClassifier {
+        context_length_patterns: patterns,
+    }
+    .classify_request_error(http(status, body))
+}
+
+#[test]
+fn context_overflow_is_recognized_in_english_chinese_and_configured_wording() {
+    for (status, body) in [
+        (
+            400,
+            r#"{"error":{"message":"This model's maximum context length is 8192 tokens","code":"context_length_exceeded"}}"#,
+        ),
+        (
+            400,
+            r#"{"error":{"message":"Input tokens exceed the configured limit","code":"context_length_exceeded"}}"#,
+        ),
+        (
+            422,
+            r#"{"error":{"message":"请求的上下文长度超过模型限制"}}"#,
+        ),
+        (413, "payload too large"),
+    ] {
+        assert!(
+            matches!(classify(status, body, &[]), ApiError::ContextWindowExceeded),
+            "{body}"
+        );
+    }
+    let patterns = vec!["Prompt Budget Overrun".to_string()];
+    assert!(matches!(
+        classify(
+            400,
+            r#"{"error":{"message":"prompt budget overrun"}}"#,
+            &patterns
+        ),
+        ApiError::ContextWindowExceeded
+    ));
+    assert!(matches!(
+        classify(
+            400,
+            r#"{"error":{"message":"invalid tool schema"}}"#,
+            &patterns
+        ),
+        ApiError::Transport(TransportError::Http { .. })
+    ));
+}
+
+#[test]
+fn quota_and_throttling_are_separated() {
+    assert!(matches!(
+        classify(429, r#"{"error":{"message":"账户余额不足"}}"#, &[]),
+        ApiError::QuotaExceeded
+    ));
+    assert!(matches!(classify(402, "", &[]), ApiError::QuotaExceeded));
+    let ApiError::RateLimitExceeded {
+        message,
+        retry_after,
+    } = classify(
+        429,
+        r#"{"error":{"message":"请求过于频繁，请稍后再试"}}"#,
+        &[],
+    )
+    else {
+        panic!("expected rate limiting");
+    };
+    assert_eq!(message, "请求过于频繁，请稍后再试");
+    assert!(retry_after.is_none());
+}
+
+#[test]
+fn refused_credentials_and_other_statuses_are_left_for_shared_handling() {
+    for status in [401, 500, 503] {
+        assert!(matches!(
+            classify(status, r#"{"error":{"message":"context length"}}"#, &[]),
+            ApiError::Transport(TransportError::Http { .. })
+        ));
+    }
+}
+
+#[test]
+fn stream_error_chunks_are_classified_by_wording() {
+    let classifier = ChatErrorClassifier {
+        context_length_patterns: &[],
+    };
+    assert!(matches!(
+        classifier.classify_stream_error(
+            &json!({ "message": "context window exceeded", "type": "invalid_request_error" })
+        ),
+        ApiError::ContextWindowExceeded
+    ));
+    assert!(matches!(
+        classifier.classify_stream_error(&json!({ "message": "Rate limit reached", "code": 429 })),
+        ApiError::RateLimitExceeded { .. }
+    ));
+    assert!(matches!(
+        classifier
+            .classify_stream_error(&json!({ "message": "blocked", "code": "content_filter" })),
+        ApiError::ContentFilter
+    ));
+    let ApiError::Stream(message) =
+        classifier.classify_stream_error(&json!({ "message": "upstream reset" }))
+    else {
+        panic!("expected a retryable stream error");
+    };
+    assert_eq!(message, "upstream reset");
+}
