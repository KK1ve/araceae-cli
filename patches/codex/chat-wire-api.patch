+//! Validation of providers that speak the Chat Completions wire protocol.
+
+use crate::ModelProviderInfo;
+use crate::RemoteCompactionSupport;
+use crate::WireApi;
+
+/// Request body fields owned by the request builder, which `extra_body` cannot override.
+const RESERVED_EXTRA_BODY_FIELDS: &[&str] = &[
+    "model",
+    "messages",
+    "stream",
+    "stream_options",
+    "tools",
+    "tool_choice",
+    "parallel_tool_calls",
+    "response_format",
+];
+
+pub(crate) fn validate(info: &ModelProviderInfo) -> Result<(), String> {
+    if info.wire_api != WireApi::Chat {
+        if info.chat.is_some() {
+            return Err("provider chat options require wire_api = \"chat\"".to_string());
+        }
+        return Ok(());
+    }
+    if info.supports_websockets {
+        return Err("wire_api = \"chat\" cannot be combined with supports_websockets".to_string());
+    }
+    if info
+        .capabilities
+        .and_then(|capabilities| capabilities.remote_compaction)
+        == Some(RemoteCompactionSupport::V2)
+    {
+        return Err(
+            "wire_api = \"chat\" cannot be combined with capabilities.remote_compaction = \"v2\""
+                .to_string(),
+        );
+    }
+    if info.model_catalog_url.is_some() {
+        return Err("wire_api = \"chat\" cannot be combined with model_catalog_url".to_string());
+    }
+    let Some(options) = info.chat.as_ref() else {
+        return Ok(());
+    };
+    if options.max_output_tokens == Some(0) {
+        return Err("provider chat.max_output_tokens must be greater than zero".to_string());
+    }
+    if options.max_images == Some(0) {
+        return Err("provider chat.max_images must be greater than zero".to_string());
+    }
+    if options.reasoning_field.trim().is_empty() {
+        return Err("provider chat.reasoning_field must not be empty".to_string());
+    }
+    if options
+        .context_length_error_patterns
+        .iter()
+        .any(|pattern| pattern.trim().is_empty())
+    {
+        return Err(
+            "provider chat.context_length_error_patterns must not contain empty patterns"
+                .to_string(),
+        );
+    }
+    if let Some(field) = RESERVED_EXTRA_BODY_FIELDS
+        .iter()
+        .find(|field| options.extra_body.contains_key(**field))
+    {
+        return Err(format!("provider chat.extra_body cannot set `{field}`"));
+    }
+    Ok(())
+}
