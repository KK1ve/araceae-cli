+//! Builds Chat Completions requests from Responses API requests.
+//!
+//! Message layout rules:
+//! - Developer and system messages before the first model output form one leading message,
+//!   followed by the user messages of that prefix. Later requests share the same leading
+//!   message, which keeps provider prefix caches warm.
+//! - Developer messages after the prefix follow `mid_conversation_instructions`.
+//! - Tool results directly follow the assistant message that called them; other messages that
+//!   arrive while calls are unanswered wait until the group closes, and calls without a result
+//!   receive a placeholder.
+
+use crate::common::ResponsesApiRequest;
+use crate::common::TextFormat;
+use crate::error::ApiError;
+use crate::requests::tool_alias::ToolAliasTable;
+use codex_protocol::config_types::ChatMaxTokensField;
+use codex_protocol::config_types::ChatMidConversationInstructions;
+use codex_protocol::config_types::ChatOptions;
+use codex_protocol::config_types::ChatReasoningReplay;
+use codex_protocol::config_types::ChatStructuredOutput;
+use codex_protocol::config_types::ChatSystemRole;
+use codex_protocol::config_types::ChatToolOutputImages;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ImageDetail;
+use codex_protocol::models::ImageReference;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::models::plaintext_agent_message_content;
+use serde_json::Map;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashSet;
+use std::sync::Arc;
+
+const MAX_FREEFORM_GRAMMAR_BYTES: usize = 4096;
+const RESERVED_BODY_FIELDS: &[&str] = &[
+    "model",
+    "messages",
+    "stream",
+    "stream_options",
+    "tools",
+    "tool_choice",
+    "parallel_tool_calls",
+    "response_format",
+];
+pub(crate) const INTERRUPTED_TOOL_CALL_OUTPUT: &str =
+    "[tool call was interrupted before it produced a result]";
+const IMAGE_INPUT_UNSUPPORTED: &str = "[image omitted: the model does not accept images]";
+const IMAGE_OMITTED: &str = "[image omitted]";
+const IMAGE_OVER_LIMIT: &str = "[image omitted: only the most recent images are kept]";
+const IMAGE_FILE_REFERENCE: &str = "[image omitted: file references are not supported]";
+const AUDIO_OMITTED: &str = "[audio omitted]";
+const ENCRYPTED_CONTENT_OMITTED: &str = "[encrypted content omitted]";
+const TOOL_OUTPUT_IMAGE_FOLLOWS: &str = "[image attached in the next message]";
+const TOOL_OUTPUT_IMAGES_INTRO: &str = "Images returned by the preceding tool calls:";
+
+/// A Chat Completions request body and the aliases its tools were exposed under.
+pub struct ChatRequest {
+    pub body: Value,
+    pub tools: Arc<ToolAliasTable>,
+}
+
+/// Converts a Responses request into a Chat Completions request.
+pub fn build_chat_request(
+    request: &ResponsesApiRequest,
+    options: &ChatOptions,
+) -> Result<ChatRequest, ApiError> {
+    let mut table = ToolAliasTable::default();
+    let tools = chat_tools(request, &mut table)?;
+    let mut builder = MessageBuilder::new(options, &table, &request.input);
+    for (index, item) in request.input.iter().enumerate() {
+        builder.push_item(index, item);
+    }
+    let structured_output = request.text.as_ref().and_then(|text| text.format.as_ref());
+    let messages = builder.finish(structured_output);
+
+    let mut body = Map::new();
+    body.insert("model".to_string(), json!(request.model));
+    body.insert("messages".to_string(), Value::Array(messages));
+    body.insert("stream".to_string(), json!(true));
+    if options.include_usage {
+        body.insert(
+            "stream_options".to_string(),
+            json!({ "include_usage": true }),
+        );
+    }
+    if !tools.is_empty() {
+        body.insert("tools".to_string(), Value::Array(tools));
+        if !request.parallel_tool_calls {
+            body.insert("parallel_tool_calls".to_string(), json!(false));
+        }
+    }
+    if let Some(format) = structured_output {
+        match options.structured_output {
+            ChatStructuredOutput::JsonSchema => {
+                body.insert(
+                    "response_format".to_string(),
+                    json!({
+                        "type": "json_schema",
+                        "json_schema": {
+                            "name": format.name,
+                            "schema": format.schema,
+                            "strict": format.strict,
+                        },
+                    }),
+                );
+            }
+            ChatStructuredOutput::JsonObject => {
+                body.insert(
+                    "response_format".to_string(),
+                    json!({ "type": "json_object" }),
+                );
+            }
+            ChatStructuredOutput::Prompt => {}
+        }
+    }
+    if options.send_reasoning_effort
+        && let Some(effort) = request
+            .reasoning
+            .as_ref()
+            .and_then(|reasoning| reasoning.effort.as_ref())
+    {
+        body.insert(
+            "reasoning_effort".to_string(),
+            serde_json::to_value(effort).map_err(|err| {
+                ApiError::Stream(format!("failed to encode reasoning effort: {err}"))
+            })?,
+        );
+    }
+    if let Some(max_output_tokens) = options.max_output_tokens {
+        let field = match options.max_tokens_field {
+            ChatMaxTokensField::MaxTokens => "max_tokens",
+            ChatMaxTokensField::MaxCompletionTokens => "max_completion_tokens",
+        };
+        body.insert(field.to_string(), json!(max_output_tokens));
+    }
+    for (key, value) in &options.extra_body {
+        if !RESERVED_BODY_FIELDS.contains(&key.as_str()) {
+            body.insert(key.clone(), value.clone());
+        }
+    }
+    Ok(ChatRequest {
+        body: Value::Object(body),
+        tools: Arc::new(table),
+    })
+}
+
+fn chat_tools(
+    request: &ResponsesApiRequest,
+    table: &mut ToolAliasTable,
+) -> Result<Vec<Value>, ApiError> {
+    let Some(tools) = request.tools.as_ref() else {
+        return Ok(Vec::new());
+    };
+    let tools: Vec<Value> = serde_json::from_str(tools.as_raw_value().get())
+        .map_err(|err| ApiError::Stream(format!("failed to read request tools: {err}")))?;
+    let mut chat_tools = Vec::new();
+    for tool in &tools {
+        match tool.get("type").and_then(Value::as_str) {
+            Some("function") => chat_tools.extend(function_tool(None, tool, table)),
+            Some("custom") => chat_tools.extend(freeform_tool(None, tool, table)),
+            Some("namespace") => {
+                let namespace = tool.get("name").and_then(Value::as_str);
+                for member in tool
+                    .get("tools")
+                    .and_then(Value::as_array)
+                    .into_iter()
+                    .flatten()
+                {
+                    match member.get("type").and_then(Value::as_str) {
+                        Some("function") => {
+                            chat_tools.extend(function_tool(namespace, member, table));
+                        }
+                        Some("custom") => {
+                            chat_tools.extend(freeform_tool(namespace, member, table));
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            // Hosted tools such as web_search and tool_search have no Chat Completions form.
+            _ => {}
+        }
+    }
+    Ok(chat_tools)
+}
+
+fn function_tool(
+    namespace: Option<&str>,
+    tool: &Value,
+    table: &mut ToolAliasTable,
+) -> Option<Value> {
+    let name = tool.get("name").and_then(Value::as_str)?;
+    let mut function = Map::new();
+    function.insert(
+        "name".to_string(),
+        json!(table.insert(namespace, name, /*freeform*/ false)),
+    );
+    if let Some(description) = tool
+        .get("description")
+        .and_then(Value::as_str)
+        .filter(|description| !description.is_empty())
+    {
+        function.insert("description".to_string(), json!(description));
+    }
+    function.insert(
+        "parameters".to_string(),
+        tool.get("parameters")
+            .cloned()
+            .unwrap_or_else(|| json!({ "type": "object", "properties": {} })),
+    );
+    if tool.get("strict").and_then(Value::as_bool) == Some(true) {
+        function.insert("strict".to_string(), json!(true));
+    }
+    Some(json!({ "type": "function", "function": function }))
+}
+
+fn freeform_tool(
+    namespace: Option<&str>,
+    tool: &Value,
+    table: &mut ToolAliasTable,
+) -> Option<Value> {
+    let name = tool.get("name").and_then(Value::as_str)?;
+    let mut description = tool
+        .get("description")
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+        .to_string();
+    if let Some(format) = tool.get("format")
+        && let Some(definition) = format.get("definition").and_then(Value::as_str)
+    {
+        let syntax = format
+            .get("syntax")
+            .and_then(Value::as_str)
+            .unwrap_or("text");
+        description.push_str(&format!(
+            "\n\nThe `input` argument must follow this {syntax} grammar:\n{}",
+            truncate_utf8(definition, MAX_FREEFORM_GRAMMAR_BYTES)
+        ));
+    }
+    Some(json!({
+        "type": "function",
+        "function": {
+            "name": table.insert(namespace, name, /*freeform*/ true),
+            "description": description,
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "input": { "type": "string", "description": "The raw tool input." },
+                },
+                "required": ["input"],
+                "additionalProperties": false,
+            },
+        },
+    }))
+}
+
+fn truncate_utf8(value: &str, max_bytes: usize) -> &str {
+    if value.len() <= max_bytes {
+        return value;
+    }
+    &value[..value.floor_char_boundary(max_bytes)]
+}
+
+/// An assistant tool call message whose results are still being collected.
+struct ToolGroup {
+    message_index: usize,
+    unanswered: Vec<String>,
+    answered: usize,
+    images: Vec<Value>,
+}
+
+struct MessageBuilder<'a> {
+    options: &'a ChatOptions,
+    tools: &'a ToolAliasTable,
+    instructions: Vec<String>,
+    messages: Vec<Value>,
+    prefix_end: usize,
+    replay_from: Option<usize>,
+    pending_reasoning: Vec<String>,
+    pending_instructions: Vec<String>,
+    group: Option<ToolGroup>,
+    deferred: Vec<Value>,
+    dropped_call_ids: HashSet<String>,
+    images_seen: usize,
+    images_dropped: usize,
+}
+
+impl<'a> MessageBuilder<'a> {
+    fn new(options: &'a ChatOptions, tools: &'a ToolAliasTable, input: &[ResponseItem]) -> Self {
+        let prefix_end = input
+            .iter()
+            .position(is_model_output)
+            .unwrap_or(input.len());
+        let replay_from = match options.reasoning_replay {
+            ChatReasoningReplay::None => None,
+            ChatReasoningReplay::All => Some(0),
+            ChatReasoningReplay::CurrentTurn => Some(
+                input
+                    .iter()
+                    .rposition(is_turn_boundary)
+                    .map_or(0, |index| index + 1),
+            ),
+        };
+        let images_dropped = options.max_images.map_or(0, |limit| {
+            count_images(input).saturating_sub(limit as usize)
+        });
+        Self {
+            options,
+            tools,
+            instructions: Vec::new(),
+            messages: Vec::new(),
+            prefix_end,
+            replay_from,
+            pending_reasoning: Vec::new(),
+            pending_instructions: Vec::new(),
+            group: None,
+            deferred: Vec::new(),
+            dropped_call_ids: HashSet::new(),
+            images_seen: 0,
+            images_dropped,
+        }
+    }
+
+    fn push_item(&mut self, index: usize, item: &ResponseItem) {
+        if !matches!(item, ResponseItem::Message { role, .. } if role == "developer" || role == "system")
+        {
+            self.flush_instructions();
+        }
+        match item {
+            ResponseItem::Message { role, content, .. } => match role.as_str() {
+                "developer" | "system" => {
+                    let text = text_content(content);
+                    if text.is_empty() {
+                        return;
+                    }
+                    if index < self.prefix_end {
+                        self.instructions.push(text);
+                    } else {
+                        match self.options.mid_conversation_instructions {
+                            ChatMidConversationInstructions::User => {
+                                self.pending_instructions.push(text);
+                            }
+                            ChatMidConversationInstructions::System => {
+                                self.push_message(json!({ "role": "system", "content": text }));
+                            }
+                        }
+                    }
+                }
+                "assistant" => self.push_assistant_text(text_content(content)),
+                _ => {
+                    let content = self.user_content(content);
+                    self.push_message(json!({ "role": "user", "content": content }));
+                }
+            },
+            ResponseItem::AgentMessage { content, .. } => {
+                if let Some(text) = plaintext_agent_message_content(content) {
+                    self.push_message(json!({ "role": "user", "content": text }));
+                }
+            }
+            ResponseItem::Reasoning {
+                summary, content, ..
+            } => {
+                if self.replay_from.is_some_and(|from| index >= from) {
+                    let text = reasoning_text(summary, content.as_deref());
+                    if !text.is_empty() {
+                        self.pending_reasoning.push(text);
+                    }
+                }
+            }
+            ResponseItem::FunctionCall {
+                name,
+                namespace,
+                arguments,
+                call_id,
+                ..
+            } => {
+                let alias = self.tools.alias_for(namespace.as_deref(), name);
+                self.push_tool_call(call_id, alias, arguments.clone());
+            }
+            ResponseItem::CustomToolCall {
+                name,
+                namespace,
+                input,
+                call_id,
+                ..
+            } => {
+                let alias = self.tools.alias_for(namespace.as_deref(), name);
+                self.push_tool_call(call_id, alias, json!({ "input": input }).to_string());
+            }
+            ResponseItem::FunctionCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => self.push_tool_output(call_id.as_deref(), name.as_deref(), output),
+            ResponseItem::CustomToolCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => self.push_tool_output(Some(call_id), name.as_deref(), output),
+            ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                self.dropped_call_ids.insert(call_id.clone());
+            }
+            // Responses-only items have no Chat Completions representation.
+            ResponseItem::LocalShellCall { .. }
+            | ResponseItem::AdditionalTools { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::ToolSearchOutput { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. }
+            | ResponseItem::Compaction { .. }
+            | ResponseItem::ConfigurationUpdate { .. }
+            | ResponseItem::CompactionTrigger {}
+            | ResponseItem::ContextCompaction { .. }
+            | ResponseItem::Other => {}
+        }
+    }
+
+    fn finish(mut self, structured_output: Option<&TextFormat>) -> Vec<Value> {
+        self.flush_instructions();
+        self.close_group();
+        if let Some(format) = structured_output
+            && self.options.structured_output != ChatStructuredOutput::JsonSchema
+        {
+            self.instructions.push(format!(
+                "Respond with a single JSON object that matches this JSON schema:\n{}",
+                format.schema
+            ));
+        }
+        let mut messages = Vec::with_capacity(self.messages.len() + 1);
+        if !self.instructions.is_empty() {
+            let role = match self.options.system_role {
+                ChatSystemRole::System => "system",
+                ChatSystemRole::Developer => "developer",
+            };
+            messages.push(json!({ "role": role, "content": self.instructions.join("\n\n") }));
+        }
+        messages.extend(self.messages);
+        messages
+    }
+
+    /// Appends a non-tool message, holding it back while tool results are outstanding.
+    fn push_message(&mut self, message: Value) {
+        if self.group.is_some() {
+            self.deferred.push(message);
+        } else {
+            self.messages.push(message);
+        }
+    }
+
+    fn flush_instructions(&mut self) {
+        if self.pending_instructions.is_empty() {
+            return;
+        }
+        let text = std::mem::take(&mut self.pending_instructions).join("\n\n");
+        self.push_message(json!({
+            "role": "user",
+            "content": format!("<system_instructions>\n{text}\n</system_instructions>"),
+        }));
+    }
+
+    fn take_reasoning(&mut self) -> Option<String> {
+        (!self.pending_reasoning.is_empty())
+            .then(|| std::mem::take(&mut self.pending_reasoning).join("\n\n"))
+    }
+
+    fn push_assistant_text(&mut self, text: String) {
+        self.close_group();
+        if text.is_empty() {
+            return;
+        }
+        let mut message = json!({ "role": "assistant", "content": text });
+        if let Some(reasoning) = self.take_reasoning() {
+            message[self.options.reasoning_field.as_str()] = json!(reasoning);
+        }
+        self.messages.push(message);
+    }
+
+    fn push_tool_call(&mut self, call_id: &str, alias: String, arguments: String) {
+        let call = json!({
+            "id": call_id,
+            "type": "function",
+            "function": { "name": alias, "arguments": arguments },
+        });
+        if let Some(group) = self.group.as_mut()
+            && group.answered == 0
+            && self.deferred.is_empty()
+        {
+            append_tool_call(&mut self.messages[group.message_index], call);
+            group.unanswered.push(call_id.to_string());
+            return;
+        }
+        self.close_group();
+        let reasoning = self.take_reasoning();
+        let attaches_to_text = reasoning.is_none()
+            && self.messages.last().is_some_and(|message| {
+                message["role"] == "assistant" && message.get("tool_calls").is_none()
+            });
+        if !attaches_to_text {
+            let mut message = json!({ "role": "assistant", "content": Value::Null });
+            if let Some(reasoning) = reasoning {
+                message[self.options.reasoning_field.as_str()] = json!(reasoning);
+            }
+            self.messages.push(message);
+        }
+        let message_index = self.messages.len() - 1;
+        append_tool_call(&mut self.messages[message_index], call);
+        self.group = Some(ToolGroup {
+            message_index,
+            unanswered: vec![call_id.to_string()],
+            answered: 0,
+            images: Vec::new(),
+        });
+    }
+
+    fn push_tool_output(
+        &mut self,
+        call_id: Option<&str>,
+        name: Option<&str>,
+        output: &FunctionCallOutputPayload,
+    ) {
+        let call_id = call_id.filter(|call_id| !call_id.is_empty());
+        if call_id.is_some_and(|call_id| self.dropped_call_ids.contains(call_id)) {
+            return;
+        }
+        let matched = match (self.group.as_ref(), call_id) {
+            (Some(group), Some(call_id)) => group
+                .unanswered
+                .iter()
+                .position(|pending| pending == call_id),
+            // A result without a call id belongs to the only call still waiting for one.
+            (Some(group), None) if group.unanswered.len() == 1 => Some(0),
+            _ => None,
+        };
+        let Some(position) = matched else {
+            let text = self.tool_output_text(&output.body, /*images*/ None);
+            let label = name.unwrap_or("tool");
+            self.push_message(json!({
+                "role": "user",
+                "content": format!("Tool output ({label}): {text}"),
+            }));
+            return;
+        };
+        let mut images = Vec::new();
+        let text = self.tool_output_text(&output.body, Some(&mut images));
+        let Some(group) = self.group.as_mut() else {
+            return;
+        };
+        let call_id = group.unanswered.remove(position);
+        group.answered += 1;
+        group.images.extend(images);
+        self.messages.push(json!({
+            "role": "tool",
+            "tool_call_id": call_id,
+            "content": text,
+        }));
+        if group.unanswered.is_empty() {
+            self.close_group();
+        }
+    }
+
+    fn close_group(&mut self) {
+        let Some(group) = self.group.take() else {
+            return;
+        };
+        for call_id in group.unanswered {
+            self.messages.push(json!({
+                "role": "tool",
+                "tool_call_id": call_id,
+                "content": INTERRUPTED_TOOL_CALL_OUTPUT,
+            }));
+        }
+        if !group.images.is_empty() {
+            let mut content = vec![json!({ "type": "text", "text": TOOL_OUTPUT_IMAGES_INTRO })];
+            content.extend(group.images);
+            self.messages
+                .push(json!({ "role": "user", "content": content }));
+        }
+        let deferred = std::mem::take(&mut self.deferred);
+        self.messages.extend(deferred);
+    }
+
+    fn next_image_allowed(&mut self) -> bool {
+        let index = self.images_seen;
+        self.images_seen += 1;
+        index >= self.images_dropped
+    }
+
+    fn image_part(
+        &mut self,
+        image: &ImageReference,
+        detail: Option<ImageDetail>,
+    ) -> Result<Value, &'static str> {
+        if !self.next_image_allowed() {
+            return Err(IMAGE_OVER_LIMIT);
+        }
+        if !self.options.image_input {
+            return Err(IMAGE_INPUT_UNSUPPORTED);
+        }
+        let ImageReference::Inline { image_url } = image else {
+            return Err(IMAGE_FILE_REFERENCE);
+        };
+        let mut url = json!({ "url": image_url });
+        if let Some(detail) = detail {
+            url["detail"] = json!(match detail {
+                ImageDetail::Auto => "auto",
+                ImageDetail::Low => "low",
+                ImageDetail::High | ImageDetail::Original => "high",
+            });
+        }
+        Ok(json!({ "type": "image_url", "image_url": url }))
+    }
+
+    fn user_content(&mut self, content: &[ContentItem]) -> Value {
+        let mut parts = Vec::new();
+        let mut has_image = false;
+        for item in content {
+            match item {
+                ContentItem::InputText { text } | ContentItem::OutputText { text, .. } => {
+                    parts.push(json!({ "type": "text", "text": text }));
+                }
+                ContentItem::InputImage { image, detail } => {
+                    match self.image_part(image, *detail) {
+                        Ok(part) => {
+                            has_image = true;
+                            parts.push(part);
+                        }
+                        Err(placeholder) => {
+                            parts.push(json!({ "type": "text", "text": placeholder }))
+                        }
+                    }
+                }
+                ContentItem::InputAudio { .. } => {
+                    parts.push(json!({ "type": "text", "text": AUDIO_OMITTED }));
+                }
+            }
+        }
+        if has_image {
+            return Value::Array(parts);
+        }
+        json!(
+            parts
+                .iter()
+                .filter_map(|part| part["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n")
+        )
+    }
+
+    fn tool_output_text(
+        &mut self,
+        body: &FunctionCallOutputBody,
+        mut images: Option<&mut Vec<Value>>,
+    ) -> String {
+        let items = match body {
+            FunctionCallOutputBody::Text(text) => return text.clone(),
+            FunctionCallOutputBody::ContentItems(items) => items,
+        };
+        let mut parts = Vec::new();
+        for item in items {
+            match item {
+                FunctionCallOutputContentItem::InputText { text } => parts.push(text.clone()),
+                FunctionCallOutputContentItem::InputImage { image, detail } => {
+                    let follows = images.is_some()
+                        && self.options.tool_output_images == ChatToolOutputImages::UserMessage;
+                    if !follows {
+                        // Keep the image budget aligned with the images counted up front.
+                        self.next_image_allowed();
+                        parts.push(
+                            if self.options.image_input {
+                                IMAGE_OMITTED
+                            } else {
+                                IMAGE_INPUT_UNSUPPORTED
+                            }
+                            .to_string(),
+                        );
+                        continue;
+                    }
+                    match self.image_part(image, *detail) {
+                        Ok(part) => {
+                            if let Some(images) = images.as_deref_mut() {
+                                images.push(part);
+                            }
+                            parts.push(TOOL_OUTPUT_IMAGE_FOLLOWS.to_string());
+                        }
+                        Err(placeholder) => parts.push(placeholder.to_string()),
+                    }
+                }
+                FunctionCallOutputContentItem::InputAudio { .. } => {
+                    parts.push(AUDIO_OMITTED.to_string());
+                }
+                FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                    parts.push(ENCRYPTED_CONTENT_OMITTED.to_string());
+                }
+            }
+        }
+        parts.join("\n")
+    }
+}
+
+fn append_tool_call(message: &mut Value, call: Value) {
+    match message.get_mut("tool_calls").and_then(Value::as_array_mut) {
+        Some(calls) => calls.push(call),
+        None => message["tool_calls"] = json!([call]),
+    }
+}
+
+fn is_model_output(item: &ResponseItem) -> bool {
+    match item {
+        ResponseItem::Message { role, .. } => role == "assistant",
+        ResponseItem::Reasoning { .. }
+        | ResponseItem::FunctionCall { .. }
+        | ResponseItem::CustomToolCall { .. }
+        | ResponseItem::LocalShellCall { .. }
+        | ResponseItem::ToolSearchCall { .. }
+        | ResponseItem::WebSearchCall { .. }
+        | ResponseItem::ImageGenerationCall { .. } => true,
+        _ => false,
+    }
+}
+
+/// A user message that starts a turn, as opposed to context the harness wraps in markers.
+fn is_turn_boundary(item: &ResponseItem) -> bool {
+    let ResponseItem::Message { role, content, .. } = item else {
+        return false;
+    };
+    role == "user"
+        && content.iter().any(|item| match item {
+            ContentItem::InputText { text } => !is_marked_context(text),
+            ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => true,
+            ContentItem::OutputText { .. } => false,
+        })
+}
+
+fn is_marked_context(text: &str) -> bool {
+    let text = text.trim();
+    let Some(rest) = text.strip_prefix('<') else {
+        return false;
+    };
+    let Some(tag_end) = rest.find('>') else {
+        return false;
+    };
+    let tag = &rest[..tag_end];
+    !tag.is_empty()
+        && tag.chars().all(|character| {
+            character.is_ascii_alphanumeric() || character == '_' || character == '-'
+        })
+        && text.ends_with(&format!("</{tag}>"))
+}
+
+fn count_images(input: &[ResponseItem]) -> usize {
+    input
+        .iter()
+        .map(|item| match item {
+            ResponseItem::Message { content, .. } => content
+                .iter()
+                .filter(|item| matches!(item, ContentItem::InputImage { .. }))
+                .count(),
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => match &output.body {
+                FunctionCallOutputBody::ContentItems(items) => items
+                    .iter()
+                    .filter(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }))
+                    .count(),
+                FunctionCallOutputBody::Text(_) => 0,
+            },
+            _ => 0,
+        })
+        .sum()
+}
+
+fn text_content(content: &[ContentItem]) -> String {
+    content
+        .iter()
+        .filter_map(|item| match item {
+            ContentItem::InputText { text } | ContentItem::OutputText { text, .. } => {
+                Some(text.as_str())
+            }
+            ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => None,
+        })
+        .collect::<Vec<_>>()
+        .join("")
+}
+
+fn reasoning_text(
+    summary: &[ReasoningItemReasoningSummary],
+    content: Option<&[ReasoningItemContent]>,
+) -> String {
+    let content = content
+        .unwrap_or_default()
+        .iter()
+        .map(|item| match item {
+            ReasoningItemContent::ReasoningText { text } | ReasoningItemContent::Text { text } => {
+                text.as_str()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("");
+    if !content.is_empty() {
+        return content;
+    }
+    summary
+        .iter()
+        .map(|item| match item {
+            ReasoningItemReasoningSummary::SummaryText { text } => text.as_str(),
+        })
+        .collect::<Vec<_>>()
+        .join("\n\n")
+}
