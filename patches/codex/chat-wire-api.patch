diff --git a/codex-rs/codex-api/src/requests/tool_alias.rs b/codex-rs/codex-api/src/requests/tool_alias.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ad8969a359fe4a3ef29a19179bf0b84315431c7b
--- /dev/null
+++ b/codex-rs/codex-api/src/requests/tool_alias.rs
@@ -0,0 +1,146 @@
+//! Chat Completions function names for the tools of a Responses request.
+//!
+//! Chat Completions has no tool namespaces and limits function names to 64 characters of
+//! `[A-Za-z0-9_-]`, so every tool is exposed under a deterministic alias and calls are mapped
+//! back through the table built for the request.
+
+use std::collections::HashMap;
+
+const MAX_ALIAS_LEN: usize = 64;
+const HASHED_PREFIX_LEN: usize = 53;
+const HASH_SUFFIX_LEN: usize = 10;
+const NAMESPACE_SEPARATOR: &str = "__";
+const DEFAULT_NAMESPACE: &str = "functions";
+
+/// The tool a chat function name refers to.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ToolTarget {
+    pub(crate) namespace: Option<String>,
+    pub(crate) name: String,
+    /// Freeform tools are exposed as a function with a single `input` string argument.
+    pub(crate) freeform: bool,
+}
+
+/// Aliases assigned to the tools offered in one request.
+#[derive(Debug, Default)]
+pub struct ToolAliasTable {
+    targets: HashMap<String, ToolTarget>,
+    aliases: HashMap<(Option<String>, String), String>,
+}
+
+impl ToolAliasTable {
+    /// Registers an offered tool and returns its chat function name.
+    pub(crate) fn insert(&mut self, namespace: Option<&str>, name: &str, freeform: bool) -> String {
+        let namespace = normalize_namespace(namespace);
+        let key = (namespace.map(str::to_string), name.to_string());
+        if let Some(alias) = self.aliases.get(&key) {
+            return alias.clone();
+        }
+        let mut alias = tool_alias(namespace, name);
+        if self.targets.contains_key(&alias) {
+            alias = hashed_alias(&sanitize(&joined_name(namespace, name)), namespace, name);
+            let mut attempt = 1;
+            while self.targets.contains_key(&alias) {
+                alias = hashed_alias(
+                    &sanitize(&joined_name(namespace, name)),
+                    namespace,
+                    &format!("{name}\0{attempt}"),
+                );
+                attempt += 1;
+            }
+        }
+        self.targets.insert(
+            alias.clone(),
+            ToolTarget {
+                namespace: key.0.clone(),
+                name: key.1.clone(),
+                freeform,
+            },
+        );
+        self.aliases.insert(key, alias.clone());
+        alias
+    }
+
+    /// Returns the chat function name of a tool call recorded in history.
+    ///
+    /// Tools no longer offered keep the alias computed from their name, which is the name the
+    /// model saw when it made the call.
+    pub(crate) fn alias_for(&self, namespace: Option<&str>, name: &str) -> String {
+        let namespace = normalize_namespace(namespace);
+        self.aliases
+            .get(&(namespace.map(str::to_string), name.to_string()))
+            .cloned()
+            .unwrap_or_else(|| tool_alias(namespace, name))
+    }
+
+    /// Resolves a function name produced by the model.
+    ///
+    /// Besides exact aliases this accepts namespace separators the model may have substituted
+    /// for `__`, and the bare name of a namespaced tool when only one tool has that name.
+    pub(crate) fn resolve(&self, name: &str) -> Option<&ToolTarget> {
+        if let Some(target) = self.targets.get(name) {
+            return Some(target);
+        }
+        let normalized = name.replace(['.', '/', ':'], NAMESPACE_SEPARATOR);
+        if let Some(target) = self.targets.get(&normalized) {
+            return Some(target);
+        }
+        let mut matches = self
+            .targets
+            .values()
+            .filter(|target| target.namespace.is_some() && target.name == name);
+        let first = matches.next()?;
+        matches.next().is_none().then_some(first)
+    }
+}
+
+fn normalize_namespace(namespace: Option<&str>) -> Option<&str> {
+    namespace.filter(|namespace| !namespace.is_empty() && *namespace != DEFAULT_NAMESPACE)
+}
+
+fn joined_name(namespace: Option<&str>, name: &str) -> String {
+    match namespace {
+        Some(namespace) => format!("{namespace}{NAMESPACE_SEPARATOR}{name}"),
+        None => name.to_string(),
+    }
+}
+
+fn sanitize(value: &str) -> String {
+    value
+        .chars()
+        .map(|character| {
+            if character.is_ascii_alphanumeric() || character == '_' || character == '-' {
+                character
+            } else {
+                '_'
+            }
+        })
+        .collect()
+}
+
+/// Computes the chat function name of a tool without consulting any table.
+pub(crate) fn tool_alias(namespace: Option<&str>, name: &str) -> String {
+    let namespace = normalize_namespace(namespace);
+    let alias = sanitize(&joined_name(namespace, name));
+    if alias.len() <= MAX_ALIAS_LEN {
+        alias
+    } else {
+        hashed_alias(&alias, namespace, name)
+    }
+}
+
+fn hashed_alias(sanitized: &str, namespace: Option<&str>, name: &str) -> String {
+    let prefix = &sanitized[..sanitized.len().min(HASHED_PREFIX_LEN)];
+    let digest = fnv1a64(format!("{}\0{name}", namespace.unwrap_or_default()).as_bytes());
+    format!("{prefix}_{}", &format!("{digest:016x}")[..HASH_SUFFIX_LEN])
+}
+
+fn fnv1a64(bytes: &[u8]) -> u64 {
+    bytes.iter().fold(0xcbf2_9ce4_8422_2325, |hash, byte| {
+        (hash ^ u64::from(*byte)).wrapping_mul(0x0000_0100_0000_01b3)
+    })
+}
+
+#[cfg(test)]
+#[path = "tool_alias_tests.rs"]
+mod tests;
diff --git a/codex-rs/codex-api/src/requests/tool_alias_tests.rs b/codex-rs/codex-api/src/requests/tool_alias_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e6dd3f3de18b9a397b6f471903b681f4ff48c67a
--- /dev/null
+++ b/codex-rs/codex-api/src/requests/tool_alias_tests.rs
@@ -0,0 +1,90 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn aliases_join_namespaces_and_keep_default_function_names() {
+    let mut table = ToolAliasTable::default();
+    assert_eq!(table.insert(None, "exec_command", false), "exec_command");
+    assert_eq!(
+        table.insert(Some("functions"), "update_plan", false),
+        "update_plan"
+    );
+    assert_eq!(
+        table.insert(Some("mcp__docs"), "search.files", false),
+        "mcp__docs__search_files"
+    );
+    assert_eq!(
+        table.resolve("mcp__docs__search_files"),
+        Some(&ToolTarget {
+            namespace: Some("mcp__docs".to_string()),
+            name: "search.files".to_string(),
+            freeform: false,
+        })
+    );
+}
+
+#[test]
+fn long_aliases_are_truncated_with_a_deterministic_hash() {
+    let namespace = "mcp__an_unusually_long_connector_namespace_for_testing";
+    let name = "create_a_document_with_a_very_long_tool_name";
+    let alias = tool_alias(Some(namespace), name);
+    assert_eq!(alias.len(), MAX_ALIAS_LEN);
+    assert!(alias.starts_with(&joined_name(Some(namespace), name)[..HASHED_PREFIX_LEN]));
+    assert_eq!(alias, tool_alias(Some(namespace), name));
+    assert_ne!(alias, tool_alias(Some(namespace), &format!("{name}_v2")));
+
+    let mut table = ToolAliasTable::default();
+    assert_eq!(table.insert(Some(namespace), name, false), alias);
+    assert_eq!(
+        table.resolve(&alias).map(|target| target.name.as_str()),
+        Some(name)
+    );
+}
+
+#[test]
+fn colliding_aliases_get_distinct_names() {
+    let mut table = ToolAliasTable::default();
+    let first = table.insert(Some("a"), "b__c", false);
+    let second = table.insert(Some("a__b"), "c", false);
+    assert_eq!(first, "a__b__c");
+    assert_ne!(first, second);
+    assert_eq!(
+        table
+            .resolve(&second)
+            .map(|target| target.namespace.as_deref()),
+        Some(Some("a__b"))
+    );
+    assert_eq!(table.insert(Some("a__b"), "c", false), second);
+}
+
+#[test]
+fn resolution_accepts_substituted_separators_and_unique_bare_names() {
+    let mut table = ToolAliasTable::default();
+    table.insert(Some("multi_agent_v1"), "spawn_agent", false);
+    table.insert(Some("mcp__docs"), "search", false);
+    table.insert(Some("mcp__web"), "search", false);
+
+    for name in [
+        "multi_agent_v1.spawn_agent",
+        "multi_agent_v1/spawn_agent",
+        "spawn_agent",
+    ] {
+        assert_eq!(
+            table.resolve(name).map(|target| target.name.as_str()),
+            Some("spawn_agent"),
+            "{name}"
+        );
+    }
+    assert_eq!(table.resolve("search"), None);
+    assert_eq!(table.resolve("unknown_tool"), None);
+}
+
+#[test]
+fn history_aliases_survive_tools_that_are_no_longer_offered() {
+    let table = ToolAliasTable::default();
+    assert_eq!(
+        table.alias_for(Some("mcp__retired"), "lookup"),
+        "mcp__retired__lookup"
+    );
+    assert_eq!(table.alias_for(Some("functions"), "shell"), "shell");
+}
diff --git a/codex-rs/codex-api/src/sse/chat.rs b/codex-rs/codex-api/src/sse/chat.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b10cc19807f7630331a740eb103c649fea56f80d
--- /dev/null
+++ b/codex-rs/codex-api/src/sse/chat.rs
@@ -0,0 +1,713 @@
+//! Converts Chat Completions streams into Responses stream events.
+//!
+//! Text and reasoning stream as one open output item at a time. Tool calls are accumulated
+//! from their deltas and emitted once the stream ends, after names are mapped back through the
+//! request's tool aliases.
+
+use crate::common::ResponseEvent;
+use crate::common::ResponseStream;
+use crate::endpoint::chat_errors::ChatErrorClassifier;
+use crate::error::ApiError;
+use crate::requests::tool_alias::ToolAliasTable;
+use crate::telemetry::SseTelemetry;
+use bytes::Bytes;
+use codex_client::ByteStream;
+use codex_client::StreamResponse;
+use codex_protocol::ResponseItemId;
+use codex_protocol::config_types::ChatOptions;
+use codex_protocol::error::ResponseIncompleteError;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::TokenUsage;
+use eventsource_stream::Eventsource;
+use futures::StreamExt;
+use http::HeaderMap;
+use serde_json::Value;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::time::Instant;
+use tokio::time::timeout;
+use tracing::debug;
+use tracing::trace;
+
+/// Longest wait for `[DONE]` or end of stream after a choice reported its finish reason.
+const FINISH_GRACE: Duration = Duration::from_secs(5);
+const REQUEST_ID_HEADER: &str = "x-request-id";
+const THINK_OPEN: &str = "<think>";
+const THINK_CLOSE: &str = "</think>";
+
+/// Per-request settings of the Chat Completions stream parser.
+#[derive(Clone)]
+pub(crate) struct ChatStreamSettings {
+    pub(crate) tools: Arc<ToolAliasTable>,
+    pub(crate) options: Arc<ChatOptions>,
+}
+
+pub(crate) fn spawn_chat_stream(
+    stream_response: StreamResponse,
+    idle_timeout: Duration,
+    telemetry: Option<Arc<dyn SseTelemetry>>,
+    settings: ChatStreamSettings,
+) -> ResponseStream {
+    let upstream_request_id = request_id(&stream_response.headers);
+    let (tx_event, rx_event) = mpsc::channel::<Result<ResponseEvent, ApiError>>(1600);
+    tokio::spawn(process_chat_sse(
+        stream_response.bytes,
+        tx_event,
+        idle_timeout,
+        telemetry,
+        settings,
+    ));
+    ResponseStream {
+        rx_event,
+        upstream_request_id,
+        interrupt: None,
+    }
+}
+
+/// Emits the events of a complete, non-streaming chat completion.
+pub(crate) fn spawn_chat_completion(
+    body: Bytes,
+    upstream_request_id: Option<String>,
+    settings: ChatStreamSettings,
+) -> ResponseStream {
+    let (tx_event, rx_event) = mpsc::channel::<Result<ResponseEvent, ApiError>>(64);
+    tokio::spawn(async move {
+        let mut state = ChatStreamState::new(settings);
+        let completion = match serde_json::from_slice::<Value>(&body) {
+            Ok(completion) => completion,
+            Err(err) => {
+                let _ = tx_event
+                    .send(Err(ApiError::Stream(format!(
+                        "failed to parse chat completion: {err}"
+                    ))))
+                    .await;
+                return;
+            }
+        };
+        let mut events = Vec::new();
+        state.apply_completion(&completion, &mut events);
+        events.extend(state.finish());
+        for event in events {
+            if tx_event.send(event).await.is_err() {
+                return;
+            }
+        }
+    });
+    ResponseStream {
+        rx_event,
+        upstream_request_id,
+        interrupt: None,
+    }
+}
+
+pub(crate) fn request_id(headers: &HeaderMap) -> Option<String> {
+    headers
+        .get(REQUEST_ID_HEADER)
+        .and_then(|value| value.to_str().ok())
+        .map(str::to_string)
+}
+
+async fn process_chat_sse(
+    stream: ByteStream,
+    tx_event: mpsc::Sender<Result<ResponseEvent, ApiError>>,
+    idle_timeout: Duration,
+    telemetry: Option<Arc<dyn SseTelemetry>>,
+    settings: ChatStreamSettings,
+) {
+    let mut stream = stream.eventsource();
+    let mut state = ChatStreamState::new(settings);
+    loop {
+        let wait = if state.finish_reason.is_some() {
+            idle_timeout.min(FINISH_GRACE)
+        } else {
+            idle_timeout
+        };
+        let start = Instant::now();
+        let response = tokio::select! {
+            biased;
+            _ = tx_event.closed() => return,
+            response = timeout(wait, stream.next()) => response,
+        };
+        if let Some(telemetry) = telemetry.as_ref() {
+            telemetry.on_sse_poll(&response, start.elapsed());
+        }
+        let mut events = Vec::new();
+        let finished = match response {
+            Ok(Some(Ok(sse))) => {
+                trace!("Chat SSE event: {}", &sse.data);
+                if sse.data.trim() == "[DONE]" {
+                    true
+                } else {
+                    match serde_json::from_str::<Value>(&sse.data) {
+                        Ok(chunk) => state.apply_chunk(&chunk, &mut events),
+                        Err(err) => {
+                            debug!(%err, payload_bytes = sse.data.len(), "Failed to parse chat chunk");
+                            false
+                        }
+                    }
+                }
+            }
+            Ok(Some(Err(err))) => {
+                debug!("Chat SSE error: {err:#}");
+                let error = match err {
+                    eventsource_stream::EventStreamError::Transport(
+                        error @ codex_client::TransportError::Policy(_),
+                    ) => ApiError::Transport(error),
+                    error => ApiError::Stream(error.to_string()),
+                };
+                events.push(Err(error));
+                true
+            }
+            Ok(None) => true,
+            // A provider that reported its finish reason may keep the connection open.
+            Err(_) if state.finish_reason.is_some() => true,
+            Err(_) => {
+                events.push(Err(ApiError::Stream(
+                    "idle timeout waiting for chat completion chunks".into(),
+                )));
+                true
+            }
+        };
+        let failed = events.iter().any(Result::is_err);
+        if finished && !failed {
+            events.extend(state.finish());
+        }
+        for event in events {
+            if tx_event.send(event).await.is_err() {
+                return;
+            }
+        }
+        if finished || failed {
+            return;
+        }
+    }
+}
+
+enum OpenItem {
+    Reasoning { id: ResponseItemId, text: String },
+    Message { id: ResponseItemId, text: String },
+}
+
+#[derive(Default)]
+struct ToolCallSlot {
+    index: Option<i64>,
+    id: Option<String>,
+    name: String,
+    arguments: String,
+}
+
+#[derive(PartialEq, Eq)]
+enum ThinkState {
+    /// Content so far could still begin with a think block.
+    Undecided,
+    Thinking,
+    Done,
+}
+
+struct ChatStreamState {
+    settings: ChatStreamSettings,
+    response_id: Option<String>,
+    created: bool,
+    open: Option<OpenItem>,
+    tool_calls: Vec<ToolCallSlot>,
+    finish_reason: Option<String>,
+    usage: Option<TokenUsage>,
+    think: ThinkState,
+    think_buffer: String,
+}
+
+type Events = Vec<Result<ResponseEvent, ApiError>>;
+
+impl ChatStreamState {
+    fn new(settings: ChatStreamSettings) -> Self {
+        let think = if settings.options.think_tags {
+            ThinkState::Undecided
+        } else {
+            ThinkState::Done
+        };
+        Self {
+            settings,
+            response_id: None,
+            created: false,
+            open: None,
+            tool_calls: Vec::new(),
+            finish_reason: None,
+            usage: None,
+            think,
+            think_buffer: String::new(),
+        }
+    }
+
+    /// Applies one stream chunk and reports whether the stream ended with an error.
+    fn apply_chunk(&mut self, chunk: &Value, events: &mut Events) -> bool {
+        if let Some(error) = chunk
+            .get("error")
+            .filter(|_| chunk.get("choices").is_none())
+        {
+            let classifier = ChatErrorClassifier {
+                context_length_patterns: &self.settings.options.context_length_error_patterns,
+            };
+            events.push(Err(classifier.classify_stream_error(error)));
+            return true;
+        }
+        self.note_response(chunk, events);
+        for choice in chunk
+            .get("choices")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+        {
+            if let Some(delta) = choice.get("delta") {
+                self.apply_message(delta, events);
+                for call in delta
+                    .get("tool_calls")
+                    .and_then(Value::as_array)
+                    .into_iter()
+                    .flatten()
+                {
+                    self.apply_tool_call_delta(call);
+                }
+            }
+            if let Some(reason) = choice.get("finish_reason").and_then(Value::as_str) {
+                self.finish_reason = Some(reason.to_string());
+            }
+        }
+        false
+    }
+
+    /// Applies a complete non-streaming chat completion.
+    fn apply_completion(&mut self, completion: &Value, events: &mut Events) {
+        if let Some(error) = completion
+            .get("error")
+            .filter(|_| completion.get("choices").is_none())
+        {
+            let classifier = ChatErrorClassifier {
+                context_length_patterns: &self.settings.options.context_length_error_patterns,
+            };
+            events.push(Err(classifier.classify_stream_error(error)));
+            return;
+        }
+        self.note_response(completion, events);
+        let Some(choice) = completion
+            .get("choices")
+            .and_then(Value::as_array)
+            .and_then(|choices| choices.first())
+        else {
+            return;
+        };
+        if let Some(message) = choice.get("message") {
+            self.apply_message(message, events);
+            for call in message
+                .get("tool_calls")
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+            {
+                let mut slot = ToolCallSlot::default();
+                apply_tool_call_fields(&mut slot, call);
+                self.tool_calls.push(slot);
+            }
+        }
+        self.finish_reason = Some(
+            choice
+                .get("finish_reason")
+                .and_then(Value::as_str)
+                .unwrap_or("stop")
+                .to_string(),
+        );
+    }
+
+    fn note_response(&mut self, chunk: &Value, events: &mut Events) {
+        if self.response_id.is_none() {
+            self.response_id = chunk
+                .get("id")
+                .and_then(Value::as_str)
+                .filter(|id| !id.is_empty())
+                .map(str::to_string);
+        }
+        if !self.created {
+            self.created = true;
+            events.push(Ok(ResponseEvent::Created {
+                response_id: self.response_id.clone(),
+            }));
+        }
+        if let Some(usage) = chunk
+            .get("usage")
+            .filter(|usage| usage.is_object())
+            .and_then(token_usage)
+        {
+            self.usage = Some(usage);
+        }
+    }
+
+    fn apply_message(&mut self, message: &Value, events: &mut Events) {
+        // Some providers repeat the same reasoning under both field names.
+        if let Some(text) = ["reasoning_content", "reasoning"].iter().find_map(|field| {
+            message
+                .get(*field)
+                .and_then(Value::as_str)
+                .filter(|text| !text.is_empty())
+        }) {
+            self.push_reasoning(text, events);
+        }
+        for field in ["content", "refusal"] {
+            if let Some(text) = message.get(field).and_then(Value::as_str) {
+                self.push_content(text, events);
+            }
+        }
+    }
+
+    fn push_content(&mut self, text: &str, events: &mut Events) {
+        if text.is_empty() {
+            return;
+        }
+        if self.think == ThinkState::Done {
+            self.push_text(text, events);
+            return;
+        }
+        self.think_buffer.push_str(text);
+        self.drain_think_buffer(events, /*final_flush*/ false);
+    }
+
+    /// Splits buffered content into reasoning and text around a leading think block.
+    fn drain_think_buffer(&mut self, events: &mut Events, final_flush: bool) {
+        loop {
+            match self.think {
+                ThinkState::Undecided => {
+                    let trimmed = self.think_buffer.trim_start();
+                    if let Some(rest) = trimmed.strip_prefix(THINK_OPEN) {
+                        self.think_buffer = rest.to_string();
+                        self.think = ThinkState::Thinking;
+                    } else if !final_flush && THINK_OPEN.starts_with(trimmed) {
+                        return;
+                    } else {
+                        self.think = ThinkState::Done;
+                    }
+                }
+                ThinkState::Thinking => {
+                    if let Some(end) = self.think_buffer.find(THINK_CLOSE) {
+                        let reasoning = self.think_buffer[..end].to_string();
+                        let rest = self.think_buffer[end + THINK_CLOSE.len()..]
+                            .trim_start_matches(['\r', '\n'])
+                            .to_string();
+                        self.push_reasoning(&reasoning, events);
+                        self.think_buffer = rest;
+                        self.think = ThinkState::Done;
+                        continue;
+                    }
+                    let keep = if final_flush {
+                        0
+                    } else {
+                        partial_suffix_len(&self.think_buffer, THINK_CLOSE)
+                    };
+                    let emit = self.think_buffer.len() - keep;
+                    let reasoning = self.think_buffer[..emit].to_string();
+                    self.think_buffer.replace_range(..emit, "");
+                    self.push_reasoning(&reasoning, events);
+                    return;
+                }
+                ThinkState::Done => {
+                    let text = std::mem::take(&mut self.think_buffer);
+                    self.push_text(&text, events);
+                    return;
+                }
+            }
+        }
+    }
+
+    fn push_reasoning(&mut self, text: &str, events: &mut Events) {
+        if text.is_empty() {
+            return;
+        }
+        if matches!(self.open, Some(OpenItem::Message { .. })) {
+            self.close_open(events);
+        }
+        if self.open.is_none() {
+            let id = ResponseItemId::new("rs");
+            events.push(Ok(ResponseEvent::OutputItemAdded(reasoning_item(
+                &id, /*text*/ None,
+            ))));
+            self.open = Some(OpenItem::Reasoning {
+                id,
+                text: String::new(),
+            });
+        }
+        if let Some(OpenItem::Reasoning { text: buffer, .. }) = self.open.as_mut() {
+            buffer.push_str(text);
+        }
+        events.push(Ok(ResponseEvent::ReasoningContentDelta {
+            delta: text.to_string(),
+            content_index: 0,
+        }));
+    }
+
+    fn push_text(&mut self, text: &str, events: &mut Events) {
+        if text.is_empty() {
+            return;
+        }
+        if matches!(self.open, Some(OpenItem::Reasoning { .. })) {
+            self.close_open(events);
+        }
+        if self.open.is_none() {
+            let id = ResponseItemId::new("msg");
+            events.push(Ok(ResponseEvent::OutputItemAdded(message_item(
+                &id, /*text*/ None,
+            ))));
+            self.open = Some(OpenItem::Message {
+                id,
+                text: String::new(),
+            });
+        }
+        if let Some(OpenItem::Message { text: buffer, .. }) = self.open.as_mut() {
+            buffer.push_str(text);
+        }
+        events.push(Ok(ResponseEvent::OutputTextDelta(text.to_string())));
+    }
+
+    fn close_open(&mut self, events: &mut Events) {
+        match self.open.take() {
+            Some(OpenItem::Reasoning { id, text }) => {
+                events.push(Ok(ResponseEvent::OutputItemDone(reasoning_item(
+                    &id,
+                    Some(text),
+                ))));
+            }
+            Some(OpenItem::Message { id, text }) => {
+                events.push(Ok(ResponseEvent::OutputItemDone(message_item(
+                    &id,
+                    Some(text),
+                ))));
+            }
+            None => {}
+        }
+    }
+
+    fn apply_tool_call_delta(&mut self, call: &Value) {
+        let index = call.get("index").and_then(Value::as_i64);
+        let id = call
+            .get("id")
+            .and_then(Value::as_str)
+            .filter(|id| !id.is_empty());
+        let existing = match (index, id) {
+            (Some(index), id) => self
+                .tool_calls
+                .iter()
+                .rposition(|slot| slot.index == Some(index))
+                .filter(|position| {
+                    // Some providers number every parallel call 0; a new id starts a new call.
+                    !matches!(
+                        (self.tool_calls[*position].id.as_deref(), id),
+                        (Some(existing), Some(id)) if existing != id
+                    )
+                }),
+            (None, Some(id)) => self
+                .tool_calls
+                .iter()
+                .position(|slot| slot.id.as_deref() == Some(id)),
+            (None, None) => self.tool_calls.len().checked_sub(1),
+        };
+        let position = existing.unwrap_or_else(|| {
+            self.tool_calls.push(ToolCallSlot {
+                index,
+                ..Default::default()
+            });
+            self.tool_calls.len() - 1
+        });
+        apply_tool_call_fields(&mut self.tool_calls[position], call);
+    }
+
+    /// Closes open items and emits the tool calls followed by the terminal event.
+    ///
+    /// Tool calls run as soon as they are emitted, so only a completion that finished normally
+    /// emits them. A stream that ended before any finish reason commits nothing, as its text and
+    /// tool call arguments may be cut short.
+    fn finish(&mut self) -> Events {
+        let mut events = Vec::new();
+        let Some(reason) = self.finish_reason.clone() else {
+            events.push(Err(ApiError::Stream(
+                "chat completion stream ended before a finish reason".into(),
+            )));
+            return events;
+        };
+        if self.think != ThinkState::Done || !self.think_buffer.is_empty() {
+            self.drain_think_buffer(&mut events, /*final_flush*/ true);
+        }
+        self.close_open(&mut events);
+        let tool_calls = std::mem::take(&mut self.tool_calls);
+        let response_id = self
+            .response_id
+            .clone()
+            .unwrap_or_else(|| ResponseItemId::new("chatcmpl").as_str().to_string());
+        match reason.as_str() {
+            "length" => events.push(Err(ApiError::ResponseIncomplete(Box::new(
+                ResponseIncompleteError {
+                    reason: "max_output_tokens".to_string(),
+                    response_id: Some(response_id),
+                    token_usage: self.usage.clone(),
+                },
+            )))),
+            "content_filter" => events.push(Err(ApiError::ContentFilter)),
+            "insufficient_system_resource" => events.push(Err(ApiError::Retryable {
+                message: "the model provider reported insufficient system resources".to_string(),
+                retry_after: None,
+            })),
+            _ => {
+                for slot in tool_calls {
+                    events.push(Ok(ResponseEvent::OutputItemDone(self.tool_call_item(slot))));
+                }
+                events.push(Ok(ResponseEvent::Completed {
+                    response_id,
+                    token_usage: self.usage.clone(),
+                    usage_metadata: None,
+                    end_turn: None,
+                }));
+            }
+        }
+        events
+    }
+
+    fn tool_call_item(&self, slot: ToolCallSlot) -> ResponseItem {
+        let call_id = slot
+            .id
+            .unwrap_or_else(|| ResponseItemId::new("call").as_str().to_string());
+        let arguments = if slot.arguments.trim().is_empty() {
+            "{}".to_string()
+        } else {
+            slot.arguments
+        };
+        match self.settings.tools.resolve(&slot.name) {
+            Some(target) if target.freeform => ResponseItem::CustomToolCall {
+                encrypted_content: None,
+                id: None,
+                status: None,
+                call_id,
+                name: target.name.clone(),
+                namespace: target.namespace.clone(),
+                input: freeform_input(&arguments),
+                internal_chat_message_metadata_passthrough: None,
+            },
+            target => ResponseItem::FunctionCall {
+                encrypted_content: None,
+                status: None,
+                id: None,
+                name: target.map_or(slot.name, |target| target.name.clone()),
+                namespace: target.and_then(|target| target.namespace.clone()),
+                arguments,
+                encrypted_function_args: None,
+                call_id,
+                internal_chat_message_metadata_passthrough: None,
+            },
+        }
+    }
+}
+
+/// Merges one tool call delta: the first id and name win, argument fragments concatenate.
+fn apply_tool_call_fields(slot: &mut ToolCallSlot, call: &Value) {
+    if slot.id.is_none() {
+        slot.id = call
+            .get("id")
+            .and_then(Value::as_str)
+            .filter(|id| !id.is_empty())
+            .map(str::to_string);
+    }
+    let Some(function) = call.get("function") else {
+        return;
+    };
+    if slot.name.is_empty()
+        && let Some(name) = function.get("name").and_then(Value::as_str)
+    {
+        slot.name = name.to_string();
+    }
+    match function.get("arguments") {
+        Some(Value::String(arguments)) => slot.arguments.push_str(arguments),
+        Some(arguments @ Value::Object(_)) => slot.arguments.push_str(&arguments.to_string()),
+        _ => {}
+    }
+}
+
+/// Unwraps the `input` argument of a freeform tool exposed as a function.
+fn freeform_input(arguments: &str) -> String {
+    serde_json::from_str::<Value>(arguments)
+        .ok()
+        .and_then(|value| {
+            value
+                .get("input")
+                .and_then(Value::as_str)
+                .map(str::to_string)
+        })
+        .unwrap_or_else(|| arguments.to_string())
+}
+
+/// Length of the longest suffix of `text` that is a proper prefix of `marker`.
+fn partial_suffix_len(text: &str, marker: &str) -> usize {
+    (1..marker.len())
+        .rev()
+        .find(|len| text.ends_with(&marker[..*len]))
+        .unwrap_or(0)
+}
+
+fn reasoning_item(id: &ResponseItemId, text: Option<String>) -> ResponseItem {
+    ResponseItem::Reasoning {
+        id: Some(id.clone()),
+        summary: Vec::new(),
+        content: text.map(|text| vec![ReasoningItemContent::ReasoningText { text }]),
+        encrypted_content: None,
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+fn message_item(id: &ResponseItemId, text: Option<String>) -> ResponseItem {
+    ResponseItem::Message {
+        encrypted_content: None,
+        status: None,
+        id: Some(id.clone()),
+        role: "assistant".to_string(),
+        content: text
+            .map(|text| {
+                vec![ContentItem::OutputText {
+                    text,
+                    annotations: None,
+                    logprobs: None,
+                }]
+            })
+            .unwrap_or_default(),
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+
+fn token_usage(usage: &Value) -> Option<TokenUsage> {
+    let number = |value: Option<&Value>| value.and_then(Value::as_i64).unwrap_or(0);
+    let input_tokens = number(usage.get("prompt_tokens"));
+    let output_tokens = number(usage.get("completion_tokens"));
+    if input_tokens == 0 && output_tokens == 0 && usage.get("total_tokens").is_none() {
+        return None;
+    }
+    let cached_input_tokens = usage
+        .pointer("/prompt_tokens_details/cached_tokens")
+        .or_else(|| usage.get("prompt_cache_hit_tokens"))
+        .and_then(Value::as_i64)
+        .unwrap_or(0);
+    let reasoning_output_tokens =
+        number(usage.pointer("/completion_tokens_details/reasoning_tokens"));
+    let total_tokens = usage
+        .get("total_tokens")
+        .and_then(Value::as_i64)
+        .unwrap_or(input_tokens + output_tokens);
+    Some(TokenUsage {
+        input_tokens,
+        cached_input_tokens,
+        cache_write_input_tokens: 0,
+        output_tokens,
+        reasoning_output_tokens,
+        total_tokens,
+        codex_rollout_budget_units: None,
+    })
+}
