+//! Classifies Chat Completions failures into the errors the turn loop acts on.
+//!
+//! Chat providers report context overflow, quota exhaustion, and throttling with free-form
+//! messages, so these are recognized by status and wording instead of Responses error codes.
+
+use crate::error::ApiError;
+use codex_client::TransportError;
+use http::StatusCode;
+use serde_json::Value;
+
+/// Lowercase message fragments that mean the request no longer fits the context window.
+const CONTEXT_LENGTH_FRAGMENTS: &[&str] = &[
+    "context_length_exceeded",
+    "context length",
+    "context window",
+    "maximum context",
+    "too many tokens",
+    "prompt is too long",
+    "input is too long",
+    "reduce the length",
+    "maximum allowed length",
+    "exceeds the model",
+    "token limit",
+    "上下文长度",
+    "上下文过长",
+    "上下文超",
+    "超出最大长度",
+    "超过最大长度",
+    "输入过长",
+    "长度超过",
+    "超过模型",
+    "超出模型",
+    "token数超",
+];
+const QUOTA_FRAGMENTS: &[&str] = &[
+    "quota",
+    "balance",
+    "insufficient_quota",
+    "billing",
+    "余额",
+    "欠费",
+    "额度",
+];
+const RATE_LIMIT_FRAGMENTS: &[&str] = &[
+    "rate limit",
+    "rate_limit",
+    "too many requests",
+    "限流",
+    "频率",
+];
+const CONTENT_FILTER_FRAGMENTS: &[&str] = &[
+    "content_filter",
+    "content filter",
+    "content management policy",
+    "内容审核",
+    "敏感",
+];
+
+/// Error text and classification patterns of one Chat Completions provider.
+pub(crate) struct ChatErrorClassifier<'a> {
+    pub(crate) context_length_patterns: &'a [String],
+}
+
+impl ChatErrorClassifier<'_> {
+    /// Classifies a request that failed before the stream started.
+    pub(crate) fn classify_request_error(&self, error: ApiError) -> ApiError {
+        let ApiError::Transport(TransportError::Http {
+            status,
+            body,
+            retry_after,
+            ..
+        }) = &error
+        else {
+            return error;
+        };
+        let text = body.as_deref().unwrap_or_default();
+        let (message, code) = error_message_and_code(text);
+        match *status {
+            StatusCode::PAYLOAD_TOO_LARGE => ApiError::ContextWindowExceeded,
+            StatusCode::BAD_REQUEST | StatusCode::UNPROCESSABLE_ENTITY
+                if self.is_context_overflow(text, code.as_deref()) =>
+            {
+                ApiError::ContextWindowExceeded
+            }
+            StatusCode::PAYMENT_REQUIRED => ApiError::QuotaExceeded,
+            StatusCode::TOO_MANY_REQUESTS if contains_any(text, QUOTA_FRAGMENTS) => {
+                ApiError::QuotaExceeded
+            }
+            // Many Chat Completions providers throttle without a Retry-After header, which
+            // the transport mapping would treat as final.
+            StatusCode::TOO_MANY_REQUESTS => ApiError::RateLimitExceeded {
+                message: message.unwrap_or_else(|| text.to_string()),
+                retry_after: *retry_after,
+            },
+            _ => error,
+        }
+    }
+
+    /// Classifies an `error` object delivered inside the event stream.
+    pub(crate) fn classify_stream_error(&self, error: &Value) -> ApiError {
+        let message = error
+            .get("message")
+            .and_then(Value::as_str)
+            .map(str::to_string)
+            .unwrap_or_else(|| error.to_string());
+        let code = error.get("code").map(|code| {
+            code.as_str()
+                .map_or_else(|| code.to_string(), str::to_string)
+        });
+        let kind = error
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        let text = format!("{message} {} {kind}", code.as_deref().unwrap_or_default());
+        if self.is_context_overflow(&text, code.as_deref()) {
+            ApiError::ContextWindowExceeded
+        } else if contains_any(&text, QUOTA_FRAGMENTS) {
+            ApiError::QuotaExceeded
+        } else if contains_any(&text, RATE_LIMIT_FRAGMENTS) {
+            ApiError::RateLimitExceeded {
+                message,
+                retry_after: None,
+            }
+        } else if contains_any(&text, CONTENT_FILTER_FRAGMENTS) {
+            ApiError::ContentFilter
+        } else {
+            ApiError::Stream(message)
+        }
+    }
+
+    fn is_context_overflow(&self, text: &str, code: Option<&str>) -> bool {
+        code == Some("context_length_exceeded") || contains_any(text, CONTEXT_LENGTH_FRAGMENTS) || {
+            let text = text.to_lowercase();
+            self.context_length_patterns
+                .iter()
+                .any(|pattern| text.contains(&pattern.to_lowercase()))
+        }
+    }
+}
+
+fn error_message_and_code(body: &str) -> (Option<String>, Option<String>) {
+    let Ok(value) = serde_json::from_str::<Value>(body) else {
+        return (None, None);
+    };
+    let error = value.get("error").unwrap_or(&value);
+    let message = error
+        .get("message")
+        .and_then(Value::as_str)
+        .map(str::to_string);
+    let code = error.get("code").map(|code| {
+        code.as_str()
+            .map_or_else(|| code.to_string(), str::to_string)
+    });
+    (message, code)
+}
+
+fn contains_any(text: &str, fragments: &[&str]) -> bool {
+    let text = text.to_lowercase();
+    fragments.iter().any(|fragment| text.contains(fragment))
+}
+
+#[cfg(test)]
+#[path = "chat_errors_tests.rs"]
+mod tests;
