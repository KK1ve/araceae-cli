+#[tokio::test]
+async fn tool_call_deltas_accumulate_by_index_and_id() {
+    let events = run(
+        &[
+            chunk(json!({ "tool_calls": [{ "index": 0, "id": "call_a", "type": "function", "function": { "name": "multi_agent_v1__spawn_agent", "arguments": "" } }] }), None),
+            chunk(json!({ "tool_calls": [{ "index": 0, "function": { "arguments": "{\"message\":" } }] }), None),
+            chunk(json!({ "tool_calls": [{ "index": 0, "function": { "arguments": "\"x\"}" } }] }), None),
+            // A second parallel call that reuses index 0 with a new id.
+            chunk(json!({ "tool_calls": [{ "index": 0, "id": "call_b", "function": { "name": "exec_command", "arguments": "{}" } }] }), None),
+            // A call identified only by id.
+            chunk(json!({ "tool_calls": [{ "id": "call_c", "function": { "name": "apply_patch", "arguments": "{\"input\":" } }] }), None),
+            chunk(json!({ "tool_calls": [{ "function": { "arguments": "\"*** Begin Patch\"}" } }] }), None),
+            chunk(json!({ "tool_calls": [{ "index": 1, "function": { "name": "unknown_tool" } }] }), Some("tool_calls")),
+        ],
+        /*done*/ true,
+        /*keep_open*/ false,
+        settings(false),
+    )
+    .await;
+    assert_eq!(events[0], "created:chatcmpl-1");
+    assert_eq!(
+        &events[1..4],
+        [
+            "done:call:multi_agent_v1/spawn_agent:call_a:{\"message\":\"x\"}",
+            "done:call:/exec_command:call_b:{}",
+            "done:custom:apply_patch:call_c:*** Begin Patch",
+        ]
+    );
+    assert!(events[4].starts_with("done:call:/unknown_tool:call_"));
+    assert!(events[4].ends_with(":{}"));
+    assert_eq!(events[5], "completed");
