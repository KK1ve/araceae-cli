+        Some("error:context_window")
+    );
+    assert!(!events.iter().any(|event| event.starts_with("completed")));
+}
+
+#[tokio::test]
+async fn think_tags_split_across_chunks_become_reasoning() {
+    let events = run(
+        &[
+            chunk(json!({ "content": "\n<thi" }), None),
+            chunk(json!({ "content": "nk>plan</th" }), None),
+            chunk(json!({ "content": "ink>\nanswer" }), Some("stop")),
+        ],
+        /*done*/ true,
+        /*keep_open*/ false,
+        settings(true),
+    )
+    .await;
+    let done = events
+        .iter()
+        .filter(|event| event.starts_with("done:"))
+        .cloned()
+        .collect::<Vec<_>>();
+    assert_eq!(done, ["done:reasoning:plan", "done:message:answer"]);
+
+    let plain = run(
+        &[chunk(json!({ "content": "<b>bold</b>" }), Some("stop"))],
+        /*done*/ true,
+        /*keep_open*/ false,
+        settings(true),
+    )
+    .await;
+    assert!(plain.contains(&"done:message:<b>bold</b>".to_string()));
+}
+
+#[tokio::test]
+async fn complete_json_responses_emit_the_same_events() {
+    let body = json!({
+        "id": "chatcmpl-json",
+        "object": "chat.completion",
+        "choices": [{
+            "index": 0,
+            "message": {
+                "role": "assistant",
+                "reasoning_content": "why",
+                "content": "Done.",
+                "tool_calls": [{ "id": "call_a", "type": "function", "function": { "name": "exec_command", "arguments": "{\"cmd\":\"ls\"}" } }],
+            },
+            "finish_reason": "tool_calls",
+        }],
+        "usage": { "prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15, "prompt_cache_hit_tokens": 4 },
+    });
+    let mut stream = spawn_chat_completion(Bytes::from(body.to_string()), None, settings(false));
+    let mut events = Vec::new();
+    while let Some(event) = stream.rx_event.recv().await {
+        events.push(describe(event));
+    }
+    assert_eq!(
+        events,
+        [
+            "created:chatcmpl-json",
+            "added:reasoning:",
+            "reasoning:why",
+            "done:reasoning:why",
+            "added:message:",
+            "text:Done.",
+            "done:message:Done.",
+            "done:call:/exec_command:call_a:{\"cmd\":\"ls\"}",
+            "completed:10/4/5/0/15",
+        ]
+    );
+}
